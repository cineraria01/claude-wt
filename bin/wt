#!/usr/bin/env bash
# wt — 작업 1개 = 브랜치 1개 + 워크트리 1개. 끝나면 PR(squash) → 기준 브랜치 머지 → 정리.
#
#   wt start <슬러그> [--base <브랜치>]   origin/<기준>(기본: 기본 브랜치)에서 wt/<슬러그> 워크트리 생성
#   wt finish [--title <제목>]           (워크트리 안에서) rebase → 검증 → PR → squash 머지 → 정리
#   wt train [--title <제목>] <레인>...  여러 레인을 레인마다 커밋 하나로 쌓아 검증 한 번 → 한 번에 머지 → 정리
#   wt verify                           (워크트리 안에서) 검증 실행. 통과한 코드면 finish가 같은 검증을 건너뜀
#   wt list [--conflicts]                워크트리·브랜치 상태(레인마다 자기 기준으로). --conflicts: 레인별 예상 충돌
#   wt gc [--apply]                      이미 기준에 반영된 워크트리·브랜치 정리(기본은 목록만)
#   wt overlap                           (워크트리 안에서) 다른 레인·기준과 미리 합쳐 본 충돌 예고
#   wt claim [--force]                   (워크트리 안에서) 이 세션이 이 워크트리를 맡는다(재개·인계)
#
# 기준: start --base가 branch.<브랜치>.wtBase 에 남긴다(없으면 기본 브랜치). list·gc·finish·overlap이 그것을 쓴다.
# gc가 지우지 않는 브랜치: 기본 브랜치, 어떤 레인의 기준, 원격이 로컬보다 앞선 브랜치, git config wt.protect "v2 release/*"
# 소유 표식: start·claim이 <워크트리 git-dir>/wt-owner 에 세션 ID·claude pid를 남긴다.
# 그 pid가 살아 있는 다른 세션이면 finish·gc가 건드리지 않고, list에 [다른 세션 사용 중]으로 보인다.
# 미반영 커밋을 가진 채 WT_STALE_DAYS(14)일 방치되면 list에 [오래됨]. WT_FORCE_VERIFY=1이면 finish가 늘 검증.
#
# 위치: <저장소>/../<저장소이름>.wt/<슬러그>
# 저장소별 선택 파일(커밋해 두면 모든 워크트리에 적용):
#   .worktreeinclude      새 워크트리로 복사할 gitignore된 파일 패턴(.env 등)
#   .claude/wt-setup.sh   새 워크트리 준비(의존성 설치 등). WT_MAIN=메인 폴더
#   .claude/wt-verify.sh  finish에서 rebase 뒤 실행하는 검증. 실패하면 머지 중단
set -euo pipefail

die() { printf 'wt: %s\n' "$*" >&2; exit 1; }
say() { printf '▸ %s\n' "$*" >&2; }

# 끝날 때(die 포함) train의 임시 통합 워크트리를 치운다. 머지 잠금은 프로세스가 끝나면 OS가 푼다(take_lock).
WT_TMP_WT="" WT_ROOT=""
on_exit() { [ -z "$WT_TMP_WT" ] || git -C "$WT_ROOT" worktree remove --force "$WT_TMP_WT" 2>/dev/null || true; }
trap on_exit EXIT

git_common_dir() { (cd "$(git rev-parse --git-common-dir)" && pwd -P); }
main_root() { git worktree list --porcelain | sed -n '1s/^worktree //p'; }
has_origin() { git remote get-url origin >/dev/null 2>&1; }
is_github() { has_origin && git remote get-url origin | grep 'github\.com' >/dev/null; }

default_branch() {
  local b
  if has_origin; then
    b=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
    [ -n "$b" ] && { echo "${b#origin/}"; return; }
  fi
  for b in main master; do
    git show-ref --verify --quiet "refs/heads/$b" && { echo "$b"; return; }
  done
  git symbolic-ref --quiet --short HEAD
}

in_linked_worktree() { [ "$(cd "$(git rev-parse --git-dir)" && pwd -P)" != "$(git_common_dir)" ]; }

# 브랜치 내용이 이미 base에 들어가 있는가(squash 머지 포함).
content_in_base() {
  local base=$1 br=$2 tree
  git merge-base --is-ancestor "$br" "$base" && return 0
  # rebase·cherry-pick된 사본: 모든 커밋과 같은 patch-id가 base에 있다.
  # pipefail 아래에서 grep -q/head처럼 일찍 끝나는 소비자는 생산자를 SIGPIPE(141)로 죽여
  # 파이프라인 전체가 실패로 판정된다 — 이 파일의 파이프는 입력을 끝까지 읽는 형태만 쓴다.
  ! git cherry "$base" "$br" | grep '^+' >/dev/null && return 0
  tree=$(git merge-tree --write-tree "$base" "$br" 2>/dev/null | sed -n 1p) || return 1
  [ "$tree" = "$(git rev-parse "$base^{tree}")" ]
}

# 브랜치의 기준: wt start --base가 남긴 branch.<브랜치>.wtBase, 없으면 기본 브랜치.
lane_base() { { [ -n "${1-}" ] && git config "branch.$1.wtBase"; } || default_branch; }
# 기준과 비교할 ref: origin/<기준> → 로컬 <기준> → (기준 브랜치가 사라졌으면) 기본 브랜치.
base_ref() {
  local b=$1
  if ! git show-ref --verify --quiet "refs/remotes/origin/$b" && ! git show-ref --verify --quiet "refs/heads/$b"; then
    b=$(default_branch)
  fi
  if has_origin && git show-ref --verify --quiet "refs/remotes/origin/$b"; then echo "origin/$b"; else echo "$b"; fi
}
# gc가 지우지 않는 기준 브랜치: 기본 브랜치, 어떤 브랜치의 wtBase, 원격이 로컬보다 앞선 브랜치(다른 기준으로 쓰는 장기 브랜치),
# git config wt.protect의 공백 구분 패턴(예: "v2 release/*"). 패턴이 파일 이름으로 펼쳐지지 않게 서브셸에서 set -f.
is_base_branch() (
  set -f
  b=$1
  [ "$b" = "$(default_branch)" ] && exit 0
  git config --get-regexp '^branch\..*\.wtbase$' | awk '{print $2}' | grep -Fx -- "$b" >/dev/null && exit 0
  git show-ref --verify --quiet "refs/remotes/origin/$b" && [ "$(git rev-list --count "$b..origin/$b")" -gt 0 ] && exit 0
  for p in $(git config wt.protect || true); do case $b in $p) exit 0 ;; esac; done
  exit 1
)

# ── 세션 소유 표식 ─────────────────────────────────────────────
# 워크트리마다 <워크트리 git-dir>/wt-owner 에 "session pid 시각"을 남긴다.
# pid는 이 명령을 부른 claude 프로세스. 살아 있으면 그 세션이 쓰는 중으로 본다.
# 워크트리를 지우면 git-dir째 사라지므로 따로 치울 것이 없다.
my_session() { printf '%s' "${WT_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}"; }
claude_pid() {
  local p=$$ c
  while [ -n "$p" ] && [ "$p" -gt 1 ]; do
    c=$(ps -o comm= -p "$p" 2>/dev/null) || return 0
    [ "${c##*/}" = claude ] && { echo "$p"; return; }
    p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
  done
}
owner_file() { echo "$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null)/wt-owner"; }
write_owner() {
  local f; f=$(owner_file "$1")
  printf '%s %s %s\n' "$(my_session)" "${WT_CLAUDE_PID:-$(claude_pid)}" "$(date +%Y-%m-%dT%H:%M)" >"$f"
}
pid_alive() { [ -n "$1" ] && [ "$1" != - ] && kill -0 "$1" 2>/dev/null && [ "$(basename "$(ps -o comm= -p "$1" 2>/dev/null)")" = claude ]; }
# 출력: mine | other <pid> <시각> | stale | none
owner_state() {
  local f s p t; f=$(owner_file "$1")
  [ -f "$f" ] || { echo none; return; }
  read -r s p t <"$f" || true
  if [ -n "$s" ] && [ "$s" = "$(my_session)" ]; then echo mine; return; fi
  if pid_alive "$p"; then echo "other $p $t"; else echo stale; fi
}
# 하네스(Agent isolation: "worktree")가 건 잠금 "claude agent … (pid N …)"의 N이 살아 있는 다른 claude면 그 세션 에이전트가 쓰는 중이다.
agent_lock_state() {
  local lp; lp=$(git -C "$(main_root)" worktree list --porcelain | awk -v w="worktree $1" '$0==w{f=1;next} /^worktree /{f=0} f&&/^locked/&&!d{print;d=1}' | sed -nE 's/.*claude agent .*\(pid ([0-9]+).*/\1/p')
  [ -n "$lp" ] || { echo none; return; }
  if [ "$lp" = "${WT_CLAUDE_PID:-$(claude_pid)}" ]; then echo mine; elif pid_alive "$lp"; then echo "other $lp"; else echo stale; fi
}
# 마지막 활동(브랜치 마지막 커밋, 워크트리면 git-dir·최상위 항목 수정 시각 중 최신) 이후 지난 일수.
idle_days() {
  local b=$1 w=${2-} last m gd
  last=$(git log -1 --format=%ct "$b" 2>/dev/null || echo 0)
  if [ -n "$w" ]; then
    gd=$(git -C "$w" rev-parse --absolute-git-dir 2>/dev/null || true)
    # 사라진 워크트리·BSD find(-printf 없음)에서도 list를 멈추지 않게 실패는 무시한다(커밋 시각만 쓴다).
    m=$(find ${gd:+"$gd"} "$w" -maxdepth 1 -printf '%T@\n' 2>/dev/null | sort -n | tail -n 1 | cut -d. -f1) || m=""
    [ -n "$m" ] && [ "$m" -gt "$last" ] && last=$m
  fi
  echo $(( ($(date +%s) - last) / 86400 ))
}
# main에 없는 커밋을 가진 채 WT_STALE_DAYS(기본 14)일 넘게 손대지 않은 항목 표시. 자동 삭제는 하지 않는다.
stale_label() {
  local d; d=$(idle_days "$@")
  [ "$d" -ge "${WT_STALE_DAYS:-14}" ] && echo " [오래됨 ${d}일 — 사용자에게 정리 여부 확인]"
  return 0
}
# <저장소>.wt/ 밖의 워크트리(배포용 사본 등)는 wt가 만든 작업 레인이 아니다.
wt_managed() { case $1 in "$(dirname "$(main_root)")/$(basename "$(main_root)").wt/"*) return 0 ;; *) return 1 ;; esac; }
owner_label() {
  case $1 in
    mine) echo " [이 세션]" ;;
    other*) set -- $1; echo " [다른 세션 사용 중 pid $2, $3부터]" ;;
    stale) echo " [주인 세션 종료됨]" ;;
    *) echo "" ;;
  esac
}

# ── 레인 간 겹침·충돌 예고 ────────────────────────────────────
# union 머지 파일(기록 등)은 충돌하지 않으니 뺀다(표준 입력의 경로 목록을 거른다).
drop_union() { git check-attr --stdin merge | awk '{ v=$NF; sub(/: merge: [^:]*$/, ""); if (v != "union") print }'; }
# 워크트리(또는 브랜치)가 기준 이후 바꾼 파일 + 미커밋 변경.
lane_files() {
  local ref=$1 w=$2 b=$3 mb
  {
    if [ -n "$b" ] && mb=$(git merge-base "$ref" "$b" 2>/dev/null); then git diff --name-only "$mb" "$b"; fi
    [ -n "$w" ] && git -C "$w" status --porcelain 2>/dev/null | sed 's/^...//; s/.* -> //'
  } | sed '/^$/d' | sort -u | drop_union
}
# 레인 내용(브랜치 + 미커밋 추적 파일 변경)을 커밋 하나로. 그 워크트리의 index는 건드리지 않게 사본으로 만든다
# (다른 세션이 쓰는 중일 수 있다). 미커밋이 없거나 실패하면 브랜치를 그대로 낸다.
lane_snap() {
  local w=$1 b=$2 idx t
  if [ -n "$(git -C "$w" status --porcelain --untracked-files=no 2>/dev/null)" ] && idx=$(mktemp); then
    if cp "$(git -C "$w" rev-parse --absolute-git-dir)/index" "$idx" \
      && t=$(GIT_INDEX_FILE=$idx git -C "$w" add -u 2>/dev/null && GIT_INDEX_FILE=$idx git -C "$w" write-tree); then
      rm -f "$idx"
      GIT_AUTHOR_NAME=wt GIT_AUTHOR_EMAIL=wt GIT_COMMITTER_NAME=wt GIT_COMMITTER_EMAIL=wt git commit-tree "$t" -p "$b" -m wt-snapshot
      return
    fi
    rm -f "$idx"
  fi
  echo "$b"
}
merge_tree_ok() { git merge-tree --write-tree --name-only --no-messages HEAD HEAD >/dev/null 2>&1; }
# 두 커밋을 미리 합쳐(작업 폴더는 그대로) 충돌할 파일을 낸다. 합칠 수 없으면(git 2.38 미만 등) 2.
conflict_files() {
  local out rc=0
  out=$(git merge-tree --write-tree --name-only --no-messages "$1" "$2" 2>/dev/null) || rc=$?
  case $rc in 0) return 0 ;; 1) printf '%s\n' "$out" | sed '1d; /^$/d' | sort -u | drop_union ;; *) return 2 ;; esac
}

# 워크트리 하나를 같은 기준의 다른 레인·기준 브랜치와 미리 합쳐 본다. 보일 것이 있으면 1.
# 두 번째 인자: brief = 한 줄 요약, conflicts = 충돌만. 기준이 다른 레인끼리는 서로 머지되지 않으니 보지 않는다.
show_overlap() {
  local me=$1 mode=${2-} root mybr mybase myref mine snap="" mt=1 buf="" nc=0 na=0 nf=0 nw=0 nb=0
  root=$(main_root)
  mybr=$(git -C "$me" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  mybase=$(lane_base "$mybr"); myref=$(base_ref "$mybase")
  mine=$(lane_files "$myref" "$me" "$mybr")
  merge_tree_ok || mt=0
  if [ -n "$mine" ] && [ $mt = 1 ]; then
    snap=$(lane_snap "$me" "$mybr")
    local bc; bc=$(conflict_files "$snap" "$myref" || true)
    if [ -n "$bc" ]; then
      nb=$(printf '%s\n' "$bc" | wc -l | tr -d ' ')
      buf+="  충돌 예상 기준 $myref (그사이 들어간 변경과 같은 줄)"$'\n'$(printf '%s\n' "$bc" | sed 's/^/      /')$'\n'
    fi
  fi
  while IFS=$'\t' read -r w b; do
    [ "$w" = "$root" ] || [ "$w" = "$me" ] && continue
    [ "$(lane_base "$b")" = "$mybase" ] || continue
    local theirs common cf who
    theirs=$(lane_files "$myref" "$w" "$b")
    [ -n "$theirs" ] || continue
    who="$w ($b)$(owner_label "$(owner_state "$w")")"
    if [ -z "$mine" ]; then
      # 아직 바꾼 게 없으면(새로 시작) 다른 레인이 쥐고 있는 파일을 알려만 준다.
      nw=$((nw + 1))
      buf+="  작업 중 $who"$'\n'$(printf '%s\n' "$theirs" | sed -n '1,15s/^/      /p')$'\n'
      [ "$(printf '%s\n' "$theirs" | wc -l)" -gt 15 ] && buf+="      …"$'\n'
      continue
    fi
    common=$(comm -12 <(printf '%s\n' "$mine") <(printf '%s\n' "$theirs"))
    [ -n "$common" ] || continue
    if [ $mt = 0 ]; then
      nf=$((nf + 1)); buf+="  겹침 $who"$'\n'$(printf '%s\n' "$common" | sed 's/^/      /')$'\n'
      continue
    fi
    cf=$(conflict_files "$snap" "$(lane_snap "$w" "$b")" || true)
    cf=$(comm -12 <(printf '%s\n' "$cf") <(printf '%s\n' "$common"))
    if [ -n "$cf" ]; then
      nc=$((nc + 1)); buf+="  충돌 예상 $who"$'\n'$(printf '%s\n' "$cf" | sed 's/^/      /')$'\n'
    else
      na=$((na + 1)); buf+="  겹침(자동 병합 가능) $who: $(printf '%s\n' "$common" | sed -n '1,5p' | paste -sd ' ' -)"$'\n'
    fi
  done < <(git worktree list --porcelain | awk '/^worktree /{w=substr($0,10)} /^branch /{print w"\t"substr($0,19)}')
  case $mode in
    conflicts) buf=$(printf '%s' "$buf" | awk '/^  [^ ]/{keep=/^  충돌 예상/} keep') ;;
    brief)
      buf=""
      [ $nc -gt 0 ] && buf+=" · 다른 레인과 충돌 예상 ${nc}곳"
      [ $nb -gt 0 ] && buf+=" · 기준과 충돌 예상 파일 ${nb}개"
      [ $na -gt 0 ] && buf+=" · 겹치지만 자동 병합 가능 ${na}곳"
      [ $nf -gt 0 ] && buf+=" · 같은 파일 겹침 ${nf}곳"
      [ $nw -gt 0 ] && buf+=" · 작업 중 레인 ${nw}곳"
      [ -n "$buf" ] && buf="  ${buf# · } (자세히: wt overlap)" ;;
  esac
  [ -n "$buf" ] || return 0
  printf '%s\n' "${buf%$'\n'}"
  return 1
}

cmd_overlap() {
  git rev-parse --git-dir >/dev/null 2>&1 || die "git 저장소가 아닙니다"
  in_linked_worktree || die "작업 워크트리 안에서 실행하세요"
  local me out; me=$(git rev-parse --show-toplevel)
  if out=$(show_overlap "$me"); then say "다른 레인과 겹치는 파일 없음"; return; fi
  printf '%s\n' "$out"
  merge_tree_ok || { say "위 파일은 다른 레인도 고치는 중입니다(git 2.38 미만이라 줄 단위 판정 없음). 먼저 끝나는 쪽 뒤에 rebase 충돌이 날 수 있습니다"; return; }
  say "충돌 예상: 먼저 끝나는 쪽 뒤에 같은 줄 rebase 충돌. 자동 병합 가능: 같은 파일이지만 줄이 겹치지 않음"
}

cmd_claim() {
  git rev-parse --git-dir >/dev/null 2>&1 || die "git 저장소가 아닙니다"
  in_linked_worktree || die "작업 워크트리 안에서 실행하세요"
  local me st; me=$(git rev-parse --show-toplevel); st=$(owner_state "$me")
  case $st in other*) [ "${1-}" = --force ] || die "다른 세션이 쓰는 중입니다$(owner_label "$st"). 그 세션이 끝났는지 확인 후 wt claim --force" ;; esac
  write_owner "$me"; say "이 세션이 $me 를 맡습니다"
}

# 새 워크트리 준비: .worktreeinclude의 gitignore 파일 사본 + .claude/wt-setup.sh. start와 train(통합 워크트리)이 쓴다.
prepare_worktree() {
  local root=$1 dir=$2
  if [ -f "$root/.worktreeinclude" ]; then
    (cd "$root" && git ls-files --others --ignored --exclude-from="$root/.worktreeinclude" --directory) \
      | while IFS= read -r f; do
          f=${f%/}; mkdir -p "$dir/$(dirname "$f")"; cp -R "$root/$f" "$dir/$f"
        done || return 1   # || 문맥에서 불려 함수 안 errexit가 꺼지므로 직접 확인
  fi
  if [ -x "$dir/.claude/wt-setup.sh" ]; then
    say "준비 스크립트 실행: .claude/wt-setup.sh"
    (cd "$dir" && WT_MAIN="$root" ./.claude/wt-setup.sh 9>&-) || return 1
  fi
}

cmd_start() {
  local slug="" base=""
  while [ $# -gt 0 ]; do
    case $1 in
      --base) base=$2; shift 2 ;;
      -*) die "알 수 없는 옵션: $1" ;;
      *) slug=$1; shift ;;
    esac
  done
  [ -n "$slug" ] || die "사용법: wt start <슬러그> [--base <브랜치>]"
  [[ $slug =~ ^[A-Za-z0-9._-]+$ ]] || die "슬러그는 영문·숫자·. _ - 만: $slug"
  git rev-parse --git-dir >/dev/null 2>&1 || die "git 저장소가 아닙니다"
  git rev-parse --verify --quiet HEAD >/dev/null || die "커밋이 없는 저장소입니다(첫 커밋은 메인 폴더에서)"

  local root; root=$(main_root)
  cd "$root"
  [ -n "$base" ] || base=$(default_branch)
  local branch="wt/$slug" dir; dir="$(dirname "$root")/$(basename "$root").wt/$slug"
  git show-ref --verify --quiet "refs/heads/$branch" && die "브랜치가 이미 있습니다: $branch (wt list)"
  [ -e "$dir" ] && die "폴더가 이미 있습니다: $dir"

  local from=$base
  if has_origin; then
    git fetch --quiet origin "$base" && from="origin/$base"
  fi
  mkdir -p "$(dirname "$dir")"
  git worktree add --quiet --no-track -b "$branch" "$dir" "$from"
  git -C "$dir" config "branch.$branch.wtBase" "$base"
  prepare_worktree "$root" "$dir" || die "준비 스크립트 실패(워크트리는 남겨 둠: $dir)"
  write_owner "$dir"
  say "워크트리: $dir  (브랜치 $branch ← $from)"
  local others
  if ! others=$(show_overlap "$dir"); then
    say "다른 레인이 작업 중인 파일(같은 파일을 고치면 나중에 rebase 충돌, 주제가 겹치면 그 레인에 합칠지 먼저 판단):"
    printf '%s\n' "$others" >&2
  fi
  echo "$dir"
}

squash_message() {
  local base=$1 title=$2 head=${3:-HEAD} n
  n=$(git rev-list --count "$base..$head")
  if [ "$n" = 1 ]; then git log -1 --format=%B "$head"; return; fi
  [ -n "$title" ] || title=$(git log --reverse --format=%s "$base..$head" | sed -n 1p)
  printf '%s\n\n' "$title"
  git log --reverse --format='* %s%n%n%b' "$base..$head" | grep -v '^Co-Authored-By:' | cat -s
  git log --format='%(trailers:key=Co-Authored-By,valueonly=false)' "$base..$head" | sort -u | sed '/^$/d'
}

# .claude/wt-verify.sh를 돌리고, 통과하면 그 코드의 트리 해시를 <워크트리 git-dir>/wt-verified 에 남긴다.
# 트리가 같으면 내용이 같으므로 finish는 그 검증을 다시 돌리지 않는다.
verified_file() { echo "$(git rev-parse --absolute-git-dir)/wt-verified"; }
run_verify() {
  say "검증 스크립트 실행: .claude/wt-verify.sh"
  ./.claude/wt-verify.sh 9>&- || return 1
  git rev-parse 'HEAD^{tree}' >"$(verified_file)"
}
cmd_verify() {
  git rev-parse --git-dir >/dev/null 2>&1 || die "git 저장소가 아닙니다"
  in_linked_worktree || die "작업 워크트리 안에서 실행하세요"
  cd "$(git rev-parse --show-toplevel)"
  [ -x .claude/wt-verify.sh ] || die "검증 스크립트(.claude/wt-verify.sh)가 없습니다"
  [ -z "$(git status --porcelain)" ] || die "커밋하지 않은 변경이 있습니다. 커밋한 코드만 검증 기록을 남깁니다"
  run_verify || die "검증 실패"
  say "검증 통과(트리 $(git rev-parse --short 'HEAD^{tree}')). rebase 뒤에도 코드가 같으면 wt finish가 검증을 건너뜁니다"
}

# 동시에 끝나는 작업끼리 머지를 한 줄로 세운다(finish·train 공용). <git-common-dir>/wt-merge.lock 에 flock을
# 이 셸의 fd 9로 건다. 어떻게 끝나든(강제 종료 포함) OS가 풀어 주므로 멈춘 잠금이 남지 않고, 쥔 쪽이 살아 있는 동안은
# 얼마든 기다린다. 오래 살 수 있는 자식(검증·준비 스크립트)에는 fd 9를 넘기지 않는다(9>&-). 파일 내용은 안내용 pid뿐.
take_lock() {
  local f waited=0 rc; f="$(git_common_dir)/wt-merge.lock"
  exec 9>>"$f"
  while :; do
    rc=0; python3 -I -c 'import fcntl, sys
try: fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError: sys.exit(1)' || rc=$?
    [ $rc = 0 ] && break
    [ $rc = 1 ] || die "머지 잠금을 걸지 못했습니다(python3 필요, 종료 코드 $rc)"
    [ $((waited % 60)) = 0 ] && say "다른 finish·train(pid $(cat "$f" 2>/dev/null))이 머지 중이라 기다립니다($((waited / 60))분 경과)"
    waited=$((waited + 1)); sleep 1
  done
  echo $$ >"$f"
}

# GitHub 밖(원격 없음 포함): 로컬 base를 rev로 fast-forward. 그 브랜치를 쥔 워크트리가 있으면 거기서.
ff_base() {
  local rev=$1 base=$2 holder
  holder=$(git worktree list --porcelain | awk -v b="refs/heads/$base" '/^worktree /{w=substr($0,10)} $0=="branch "b{print w}')
  if [ -n "$holder" ]; then
    git -C "$holder" merge --quiet --ff-only "$rev" || die "$holder 의 $base 를 fast-forward 못 함(그 폴더에 겹치는 미커밋 변경). 워크트리는 남겨 둠"
  else
    git merge-base --is-ancestor "$base" "$rev" || die "$base 가 앞서 있습니다. 다시 실행하세요"
    git branch -f "$base" "$rev"
  fi
}

# 머지가 끝난 레인의 워크트리·로컬 브랜치를 지운다.
# Agent(isolation: "worktree")가 만든 워크트리는 "claude agent ..." 사유로 잠겨 있다.
# 머지까지 끝났다는 건 작업이 끝났다는 뜻이므로 그 잠금만 푼다(다른 사유 잠금은 그대로 실패).
# git worktree lock 사유. 안 잠겼으면 빈 문자열, 사유 없이 잠겼으면 "-".
lock_reason() { git worktree list --porcelain | awk -v w="worktree $1" '$0==w{f=1;next} /^worktree /{f=0} f&&/^locked/&&!d{sub(/^locked ?/,""); print ($0=="" ? "-" : $0); d=1}'; }
remove_lane() {
  local dir=$1 branch=$2
  case "$(lock_reason "$dir")" in
    "claude agent"*) git worktree unlock "$dir" ;;
  esac
  git worktree remove --force "$dir"
  git branch -D "$branch" >/dev/null
  rmdir "$(dirname "$dir")" 2>/dev/null || true
}

# 메인 폴더가 base에 있으면 origin/base로 fast-forward.
sync_main() {
  local root=$1 base=$2
  has_origin || return 0
  git fetch --quiet --prune origin
  if [ "$(git symbolic-ref --quiet --short HEAD || true)" = "$base" ]; then
    git merge --quiet --ff-only "origin/$base" 2>/dev/null \
      || say "경고: 메인 폴더($root)를 origin/$base 로 fast-forward 못 했습니다(미커밋 변경 확인)"
  fi
}

cmd_finish() {
  local title=""
  while [ $# -gt 0 ]; do
    case $1 in
      --title) title=$2; shift 2 ;;
      *) die "알 수 없는 옵션: $1" ;;
    esac
  done
  git rev-parse --git-dir >/dev/null 2>&1 || die "git 저장소가 아닙니다"
  in_linked_worktree || die "메인 폴더가 아니라 작업 워크트리 안에서 실행하세요"
  local dir branch root base
  dir=$(git rev-parse --show-toplevel)
  cd "$dir"   # 하위 폴더에서 실행해도 .claude/wt-verify.sh를 찾게
  branch=$(git symbolic-ref --quiet --short HEAD) || die "브랜치가 없는 상태(detached)입니다"
  root=$(main_root)
  base=$(lane_base "$branch")
  [ -z "$(git status --porcelain)" ] || die "커밋하지 않은 변경이 있습니다. 먼저 커밋하세요"
  [ -d "$(git rev-parse --git-path rebase-merge)" ] || [ -d "$(git rev-parse --git-path rebase-apply)" ] \
    && die "rebase가 진행 중입니다. 충돌을 풀고 git rebase --continue 후 다시 실행하세요"
  local st; st=$(owner_state "$dir")
  case $st in other*) [ "${WT_FORCE_FINISH:-}" = 1 ] || die "다른 세션이 쓰는 워크트리입니다$(owner_label "$st"). 그 세션에서 finish하거나, 끝난 게 확실하면 wt claim --force 후 재실행" ;; esac
  local ov; ov=$(show_overlap "$dir" brief) || say "참고:${ov# }"

  take_lock

  local upstream=$base
  if has_origin; then git fetch --quiet origin "$base"; upstream="origin/$base"; fi

  if [ "$(git rev-list --count "$upstream..HEAD")" = 0 ]; then
    say "${base}에 새로 들어갈 커밋이 없습니다. 정리만 합니다"
  else
    # 레인 안에 합치기 커밋이 있으면 rebase가 커밋을 한 줄로 다시 쌓아 이미 푼 충돌을 또 낸다
    # (기준이 그대로여도). squash 머지라 결과는 같으니 기준을 merge로 받는다.
    if git merge-base --is-ancestor "$upstream" HEAD; then
      say "${upstream}이 이미 들어 있어 rebase 없이 진행합니다"
    elif [ -n "$(git rev-list --merges "$upstream..HEAD")" ]; then
      say "합치기 커밋이 있는 레인이라 rebase 대신 ${upstream}을 merge합니다"
      git merge --quiet --no-edit "$upstream" || die "merge 충돌. 이 워크트리($dir)에서 풀고 git commit → wt verify → wt finish 재실행"
    else
      say "rebase: $branch → $upstream"
      git rebase --quiet "$upstream" || die "rebase 충돌. 이 워크트리($dir)에서 풀고 git rebase --continue → wt verify → wt finish 재실행"
    fi
    if [ -x .claude/wt-verify.sh ]; then
      local tree; tree=$(git rev-parse 'HEAD^{tree}')
      if [ "${WT_FORCE_VERIFY:-}" != 1 ] && [ "$(cat "$(verified_file)" 2>/dev/null)" = "$tree" ]; then
        say "이미 검증한 코드와 같아 검증을 건너뜁니다(트리 $(git rev-parse --short "$tree"), 다시 돌리려면 WT_FORCE_VERIFY=1)"
      else
        run_verify || die "검증 실패. 고친 뒤 커밋하고 wt finish 재실행"
      fi
    fi

    if is_github && command -v gh >/dev/null; then
      local msg subject body pr state
      msg=$(squash_message "$upstream" "$title")
      # head -1 파이프는 긴 메시지에서 printf가 SIGPIPE(141)로 죽어 pipefail에 걸린다
      subject=${msg%%$'\n'*}
      body=$(printf '%s\n' "$msg" | tail -n +3)
      say "push → origin/$branch"
      git push --quiet --force-with-lease -u origin "$branch"
      pr=$(gh pr list --head "$branch" --base "$base" --state open --json number --jq '.[0].number' 2>/dev/null || true)
      if [ -z "$pr" ]; then
        gh pr create --base "$base" --head "$branch" --title "$subject" \
          --body "$(printf '%s\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\n' "$body")" >/dev/null
        pr=$(gh pr list --head "$branch" --base "$base" --state open --json number --jq '.[0].number')
      fi
      say "PR #$pr squash 머지"
      gh pr merge "$pr" --squash --subject "$subject" --body "$body" \
        || die "머지 실패(보호 규칙·체크 등). PR #$pr 을 확인하세요. 워크트리는 남겨 둠"
      state=$(gh pr view "$pr" --json state --jq .state)
      [ "$state" = MERGED ] || die "PR #$pr 상태가 $state 입니다. 워크트리는 남겨 둠"
      git push --quiet origin --delete "$branch" 2>/dev/null || true
    else
      # 원격이 없거나 GitHub가 아닌 저장소: 로컬 squash 후 base를 fast-forward.
      local msg; msg=$(squash_message "$upstream" "$title")
      git reset --soft "$upstream"
      git commit --quiet -F - <<<"$msg"
      if has_origin; then
        git push --quiet origin "HEAD:$base" || die "origin/$base 로 push 실패. 워크트리는 남겨 둠"
      fi
      ff_base "$branch" "$base"
    fi
    say "머지 완료 → $base"
  fi

  cd "$root"
  remove_lane "$dir" "$branch"
  sync_main "$root" "$base"
  say "정리 완료: 워크트리·브랜치 $branch 삭제, 메인 폴더 $root"
}

# 여러 레인을 한 번에: 잠금 한 번 → origin/<기준>의 임시 통합 워크트리에 레인마다 squash 커밋 하나씩 쌓기
# (충돌 나는 레인은 빼고 계속) → 준비·.claude/wt-verify.sh 한 번 → 한 번에 머지(레인별 커밋 유지) → 레인 정리.
# 검증이 실패하면 아무것도 머지하지 않는다. 그때는 레인마다 wt finish(각자 rebase·검증).
# 종료 코드: 0 = 모두 머지·정리, 2 = 충돌로 뺐거나 쌓은 뒤 바뀌어 남긴 레인이 있음.
cmd_train() {
  local title="" args=()
  while [ $# -gt 0 ]; do
    case $1 in
      --title) title=$2; shift 2 ;;
      -*) die "알 수 없는 옵션: $1" ;;
      *) args+=("$1"); shift ;;
    esac
  done
  [ ${#args[@]} -gt 0 ] || die "사용법: wt train [--title <제목>] <레인>...  (레인 = 슬러그·브랜치·워크트리 경로)"
  git rev-parse --git-dir >/dev/null 2>&1 || die "git 저장소가 아닙니다"
  local here=$PWD root common; root=$(main_root); common=$(git_common_dir); cd "$root"

  # 레인 확인은 잠금 전에 끝낸다: 하나라도 안 되면 아무것도 하지 않는다.
  local dirs=() branches=() base="" a b d p gd lb st
  for a in "${args[@]}"; do
    if git show-ref --verify --quiet "refs/heads/wt/$a"; then b="wt/$a"
    elif git show-ref --verify --quiet "refs/heads/$a"; then b=$a
    elif p=$(cd "$here" && cd "$a" 2>/dev/null && pwd -P); then
      [ "$(cd "$p" && git_common_dir 2>/dev/null)" = "$common" ] || die "이 저장소의 워크트리가 아닙니다: $a"
      b=$(git -C "$p" symbolic-ref --quiet --short HEAD) || die "브랜치가 없는 워크트리입니다: $a"
    else die "레인을 찾지 못했습니다: $a"; fi
    is_base_branch "$b" && die "기준 브랜치는 레인으로 묶지 않습니다: $b"
    case " ${branches[*]-} " in *" $b "*) die "같은 레인을 두 번 넣었습니다: $b" ;; esac
    d=$(git worktree list --porcelain | awk -v r="branch refs/heads/$b" '/^worktree /{w=substr($0,10)} $0==r{print w}')
    [ -n "$d" ] || die "워크트리가 없는 브랜치입니다: $b"
    [ "$d" != "$root" ] || die "메인 폴더는 레인이 아닙니다: $b"
    [ -z "$(git -C "$d" status --porcelain)" ] || die "커밋하지 않은 변경이 있습니다: $d"
    gd=$(git -C "$d" rev-parse --absolute-git-dir)
    [ -d "$gd/rebase-merge" ] || [ -d "$gd/rebase-apply" ] && die "rebase가 진행 중입니다: $d"
    st=$(owner_state "$d")
    case $st in other*) [ "${WT_FORCE_FINISH:-}" = 1 ] || die "다른 세션이 쓰는 워크트리입니다$(owner_label "$st"): $d" ;; esac
    case $(agent_lock_state "$d") in other*) die "다른 세션 에이전트가 쓰는 워크트리입니다: $d" ;; esac
    case $(lock_reason "$d") in ""|"claude agent"*) ;; *) die "잠긴 워크트리입니다(git worktree lock): $d" ;; esac
    lb=$(lane_base "$b"); [ -n "$base" ] || base=$lb
    [ "$lb" = "$base" ] || die "기준이 다른 레인은 함께 묶지 못합니다: $b(기준 $lb) ≠ 기준 $base"
    dirs+=("$d"); branches+=("$b")
  done

  take_lock
  local upstream=$base
  if has_origin; then git fetch --quiet origin "$base"; upstream="origin/$base"; fi
  WT_ROOT=$root WT_TMP_WT="$(dirname "$root")/$(basename "$root").wt/.train-$$"
  git worktree add --quiet --detach "$WT_TMP_WT" "$upstream"

  # 레인은 이름이 아니라 지금의 커밋으로 쌓는다(같은 이름 태그·쌓은 뒤 새 커밋과 섞이지 않게). 목록은 배열 번호, 공백 구분.
  local i rc out tips=() stacked="" already="" conflicted=""
  for i in "${!branches[@]}"; do
    b=${branches[$i]}
    tips[$i]=$(git rev-parse --verify --quiet "refs/heads/$b") || { say "그사이 사라진 레인: $b"; continue; }
    rc=0; out=$(git -C "$WT_TMP_WT" -c merge.ff=true merge --squash "${tips[$i]}" 2>&1) || rc=$?
    if [ $rc != 0 ]; then
      [ -n "$(git -C "$WT_TMP_WT" diff --name-only --diff-filter=U)" ] || die "$b 를 쌓지 못했습니다. 아무것도 머지하지 않았습니다: $out"
      git -C "$WT_TMP_WT" reset --quiet --hard
      conflicted+=" $i"; say "충돌로 뺌: $b"; continue
    fi
    if git -C "$WT_TMP_WT" diff --cached --quiet; then
      already+=" $i"; say "이미 ${base}에 들어 있음: $b"; continue
    fi
    git -C "$WT_TMP_WT" commit --quiet -F - <<<"$(squash_message "$upstream" "" "${tips[$i]}")"
    stacked+=" $i"; say "쌓음: $b"
  done

  local names=""
  if [ -z "$stacked" ]; then
    say "${base}에 새로 들어갈 레인이 없습니다"
  else
    # 준비 스크립트는 쌓은 뒤에 돌린다(의존성을 바꾼 레인도 그 의존성으로 검증되게).
    prepare_worktree "$root" "$WT_TMP_WT" || die "준비 스크립트 실패(통합 워크트리). 아무것도 머지하지 않았습니다"
    if [ -x "$WT_TMP_WT/.claude/wt-verify.sh" ]; then
      (cd "$WT_TMP_WT" && run_verify) \
        || die "묶음 검증 실패. 아무것도 머지하지 않았습니다. 레인마다 wt finish로 각자 검증·머지하세요"
    fi
    local tip; tip=$(git -C "$WT_TMP_WT" rev-parse HEAD)
    for i in $stacked; do names+=" ${branches[$i]#wt/}"; done
    if is_github && command -v gh >/dev/null; then
      local tb subject body pr state
      tb="wt/train-$(date +%Y%m%d-%H%M%S)-$$"
      subject=${title:-"train:$names"}
      body=$(git -C "$WT_TMP_WT" log --reverse --format='* %s' "$upstream..HEAD")
      say "push → origin/$tb"
      git push --quiet origin "$tip:refs/heads/$tb"
      gh pr create --base "$base" --head "$tb" --title "$subject" \
        --body "$(printf '%s\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\n' "$body")" >/dev/null \
        || { git push --quiet origin --delete "$tb" 2>/dev/null || true; die "PR을 만들지 못했습니다. 레인은 그대로입니다"; }
      pr=$(gh pr list --head "$tb" --base "$base" --state open --json number --jq '.[0].number')
      say "PR #$pr rebase 머지(레인마다 커밋 하나)"
      if ! gh pr merge "$pr" --rebase; then
        gh pr close "$pr" --delete-branch >/dev/null 2>&1 || true
        die "머지 실패(rebase 머지 허용 여부·보호 규칙·체크 등). PR #$pr 은 닫았습니다. 레인은 그대로 — 레인마다 wt finish"
      fi
      state=$(gh pr view "$pr" --json state --jq .state)
      [ "$state" = MERGED ] || die "PR #$pr 상태가 $state 입니다. 레인 워크트리는 남겨 둠"
      git push --quiet origin --delete "$tb" 2>/dev/null || true
    else
      if has_origin; then
        git push --quiet origin "$tip:refs/heads/$base" || die "origin/$base 로 push 실패. 레인 워크트리는 남겨 둠"
      fi
      ff_base "$tip" "$base"
    fi
    say "머지 완료 → $base:$names"
  fi

  git worktree remove --force "$WT_TMP_WT"; WT_TMP_WT=""
  has_origin && git fetch --quiet origin "$base"
  local changed=""
  for i in $stacked $already; do
    b=${branches[$i]} d=${dirs[$i]}
    # 쌓은 뒤 레인에 새 커밋·미커밋 변경이 생겼으면 지우지 않는다(그 변경은 아직 머지되지 않았다).
    if [ "$(git rev-parse --verify --quiet "refs/heads/$b" || true)" != "${tips[$i]}" ] \
      || [ -n "$(git -C "$d" status --porcelain 2>/dev/null)" ]; then
      changed+=" $i"; continue
    fi
    remove_lane "$d" "$b"
    # 원격 레인 브랜치는 내용이 기준에 다 들어 있을 때만 지운다(다른 곳에서 더 push했을 수 있다).
    if has_origin && git show-ref --verify --quiet "refs/remotes/origin/$b" && content_in_base "$upstream" "origin/$b"; then
      git push --quiet origin --delete "$b" 2>/dev/null || true
    fi
  done
  sync_main "$root" "$base"
  say "정리 완료: 머지${names:- 없음}, 메인 폴더 $root"
  [ -n "$conflicted$changed" ] || return 0
  if [ -n "$conflicted" ]; then
    say "충돌로 뺀 레인(그 워크트리에서 wt finish → rebase 충돌을 풀고 각자 머지):"
    for i in $conflicted; do printf '  %s  %s\n' "${dirs[$i]}" "${branches[$i]}" >&2; done
  fi
  if [ -n "$changed" ]; then
    say "쌓은 뒤 새 커밋·미커밋 변경이 생겨 남긴 레인(쌓은 부분은 들어갔음, 남은 변경은 그 워크트리에서 wt finish):"
    for i in $changed; do printf '  %s  %s\n' "${dirs[$i]}" "${branches[$i]}" >&2; done
  fi
  exit 2
}

# list 한 줄의 꼬리: 자기 기준 대비 앞선 커밋 수, [기준 X](기본 브랜치가 아닐 때), [X에 반영됨]/[오래됨]/[기준 브랜치].
branch_status() {
  local b=$1 w=${2-} base ref tag=""
  base=$(lane_base "$b"); ref=$(base_ref "$base")
  [ "$base" = "$(default_branch)" ] || tag=" [기준 $base]"
  printf '+%s%s' "$(git rev-list --count "$ref..$b")" "$tag"
  if is_base_branch "$b"; then printf ' [기준 브랜치]'
  elif content_in_base "$ref" "$b"; then printf ' [%s에 반영됨]' "$base"
  else stale_label "$b" "$w"; fi
}

cmd_list() {
  git rev-parse --git-dir >/dev/null 2>&1 || die "git 저장소가 아닙니다"
  cd "$(main_root)"
  local base; base=$(default_branch)
  printf '기준: %s (다른 기준 레인은 [기준 X])\n' "$(base_ref "$base")"
  git worktree list --porcelain | awk '/^worktree /{w=substr($0,10)} /^branch /{print w"\t"substr($0,19)} /^detached/{print w"\t(detached)"}' |
    while IFS=$'\t' read -r w b; do
      [ "$w" = "$(main_root)" ] && continue
      local st=""; [ -n "$(git -C "$w" status --porcelain 2>/dev/null)" ] && st=" 미커밋변경"
      local mg=""; wt_managed "$w" || mg=" [wt 관리 밖]"
      if [ "$b" = "(detached)" ]; then printf '  워크트리 %s  (detached)%s%s\n' "$w" "$st" "$mg"; continue; fi
      local al=""; case $(agent_lock_state "$w") in other*) al=" [다른 세션 에이전트 실행 중]" ;; mine) al=" [이 세션 에이전트]" ;; esac
      printf '  워크트리 %s  %s  %s%s%s%s%s\n' "$w" "$b" "$(branch_status "$b" "$w")" "$st" "$(owner_label "$(owner_state "$w")")" "$al" "$mg"
    done
  git for-each-ref --format='%(refname:short)' refs/heads | while read -r b; do
    [ "$b" = "$base" ] && continue
    git worktree list --porcelain | grep -x "branch refs/heads/$b" >/dev/null && continue
    printf '  브랜치만 %s  %s\n' "$b" "$(branch_status "$b")"
  done
  [ "${1-}" = --conflicts ] || return 0
  merge_tree_ok || die "--conflicts는 git 2.38 이상이 필요합니다(git merge-tree --write-tree)"
  echo "예상 충돌(같은 기준 레인끼리·기준과 미리 합쳐 봄):"
  local w found=0 out
  while IFS= read -r w; do
    [ "$w" = "$(main_root)" ] && continue
    out=$(show_overlap "$w" conflicts) && continue
    found=1; printf '  [%s]\n%s\n' "$w" "$(printf '%s\n' "$out" | sed 's/^/  /')"
  done < <(git worktree list --porcelain | awk '/^worktree /{w=substr($0,10)} /^branch /{print w}')
  [ $found = 1 ] || echo "  없음"
}

cmd_gc() {
  local apply=0; [ "${1-}" = --apply ] && apply=1
  git rev-parse --git-dir >/dev/null 2>&1 || die "git 저장소가 아닙니다"
  local root; root=$(main_root); cd "$root"
  has_origin && git fetch --quiet --prune origin
  [ $apply = 1 ] && git worktree prune
  local base; base=$(default_branch)
  local n=0
  while IFS=$'\t' read -r w b; do
    [ "$w" = "$root" ] && continue
    # 강제 종료로 남은 train 통합 워크트리(<저장소>.wt/.train-<pid>, detached): 그 pid가 끝났으면 지운다.
    case $w in
      "$(dirname "$root")/$(basename "$root").wt/.train-"*)
        kill -0 "${w##*.train-}" 2>/dev/null && continue
        n=$((n + 1)); printf '  정리 대상(끝난 train의 통합 워크트리) %s\n' "$w"
        [ $apply = 1 ] && git worktree remove --force "$w"
        continue ;;
    esac
    [ -n "$b" ] || continue
    [ -z "$(git -C "$w" status --porcelain 2>/dev/null)" ] || { printf '  유지(미커밋 변경) %s\n' "$w"; continue; }
    is_base_branch "$b" && { printf '  유지(기준 브랜치) %s  %s\n' "$w" "$b"; continue; }
    case $(owner_state "$w") in other*) printf '  유지(다른 세션 사용 중) %s  %s\n' "$w" "$b"; continue ;; esac
    case $(agent_lock_state "$w") in other*) printf '  유지(다른 세션 에이전트 잠금) %s  %s\n' "$w" "$b"; continue ;; esac
    # 방금 만든 워크트리는 커밋이 없어도 main과 같아 보인다. 다른 세션 것일 수 있으니 하루 동안은 건드리지 않는다.
    local gd; gd=$(git -C "$w" rev-parse --absolute-git-dir 2>/dev/null)
    if [ -n "$gd" ] && [ -n "$(find "$gd" "$w" -maxdepth 1 -mmin -1440 2>/dev/null | sed -n 1p)" ]; then
      printf '  유지(24시간 내 사용) %s  %s\n' "$w" "$b"; continue
    fi
    content_in_base "$(base_ref "$(lane_base "$b")")" "$b" || { printf '  유지(미반영 커밋) %s  %s\n' "$w" "$b"; continue; }
    n=$((n + 1)); printf '  정리 대상 워크트리 %s  %s\n' "$w" "$b"
    if [ $apply = 1 ]; then git worktree remove --force "$w"; git branch -D "$b" >/dev/null; fi
  done < <(git worktree list --porcelain | awk '/^worktree /{w=substr($0,10)} /^branch /{print w"\t"substr($0,19)} /^detached/{print w"\t"}')
  while read -r b; do
    [ "$b" = "$base" ] && continue
    git worktree list --porcelain | grep -x "branch refs/heads/$b" >/dev/null && continue
    is_base_branch "$b" && { printf '  유지(기준 브랜치) 브랜치 %s\n' "$b"; continue; }
    content_in_base "$(base_ref "$(lane_base "$b")")" "$b" || { printf '  유지(미반영 커밋) 브랜치 %s\n' "$b"; continue; }
    n=$((n + 1)); printf '  정리 대상 브랜치 %s\n' "$b"
    [ $apply = 1 ] && git branch -D "$b" >/dev/null
  done < <(git for-each-ref --format='%(refname:short)' refs/heads)
  # 마지막 워크트리를 지우면 <저장소>.wt/ 빈 폴더만 남는다(비어 있을 때만 지워짐)
  [ $apply = 1 ] && { rmdir "$(dirname "$root")/$(basename "$root").wt" 2>/dev/null || true; }
  if [ $apply = 1 ]; then say "${n}개 정리함"; else say "${n}개 정리 가능. 실행: wt gc --apply"; fi
}

case ${1-} in
  start) shift; cmd_start "$@" ;;
  finish) shift; cmd_finish "$@" ;;
  train) shift; cmd_train "$@" ;;
  list|ls) shift; cmd_list "$@" ;;
  gc) shift; cmd_gc "$@" ;;
  overlap) shift; cmd_overlap "$@" ;;
  claim) shift; cmd_claim "$@" ;;
  verify) shift; cmd_verify "$@" ;;
  *) awk 'NR>1 && /^set -e/{exit} NR>1{sub(/^# ?/,""); print}' "$0"; exit 1 ;;
esac
