#!/usr/bin/env bash
# wt — 작업 1개 = 브랜치 1개 + 워크트리 1개. 끝나면 PR(squash) → 기준 브랜치 머지 → 정리.
#
#   wt start <슬러그> [--base <브랜치>]   origin/<기준>(기본: 기본 브랜치)에서 wt/<슬러그> 워크트리 생성
#   wt finish [--title <제목>] [--priority critical|release|normal] [--wait <초>]
#                                        (워크트리 안에서) rebase → 검증 → 머지 순번 → PR → squash 머지 → 정리
#   wt train [--title <제목>] [--priority …] [--wait <초>] <레인>...
#                                        여러 레인을 레인마다 커밋 하나로 쌓아 검증 한 번 → 한 번에 머지 → 정리
#   wt verify                           (워크트리 안에서) 검증 실행. 통과한 코드면 finish가 같은 검증을 건너뜀
#   wt ready [--note <글>] | --cancel    (워크트리 안에서) rebase → 검증 → push → origin에 준비됨 표식. 머지는 기다리지 않음
#   wt flush [--base <브랜치>] [--title <제목>] [--priority …] [--wait <초>]
#                                        origin의 준비됨 레인 전부(어느 기계 것이든)를 쌓아 검증 한 번 → 한 번에 머지
#                                        0 머지(또는 없음) | 3 충돌로 뺀 레인 있음·대기 시간 초과 | 1 실패(검증 실패면 아무것도 머지 안 함)
#   wt list [--conflicts]                워크트리·브랜치 상태(레인마다 자기 기준으로). --conflicts: 레인별 예상 충돌
#   wt gc [--apply]                      이미 기준에 반영된 워크트리·브랜치 정리(기본은 목록만)
#   wt overlap                           (워크트리 안에서) 다른 레인·기준과 미리 합쳐 본 충돌 예고
#   wt claim [--force]                   (워크트리 안에서) 이 세션이 이 워크트리를 맡는다(재개·인계)
#   wt claim <이름> [--wait <초>] [--stale <초>] [--pid <pid>] [--note <글>]
#                                        기계 간 선점: origin에 refs/wt-claims/<이름>을 없을 때만 만든다
#                                        0 + sha | 3 + 선점자 줄(sha=… host=… pid=… at=… note=…) | 1 네트워크·권한·origin 없음
#   wt unclaim <이름> <sha>              원격 선점이 아직 그 sha일 때만 지운다(없으면 0, 다른 sha면 1)
#   wt claims                            origin의 선점 목록(이름·선점자·나이)
#   wt queue [--base <브랜치>]            머지 대기열(GitHub origin의 refs/wt-queue/<기준>/): 순번·등급·host·kind·나이·차례
#   wt queue enter <merge|train|release> --pid <pid> [--priority …] [--wait <초>] [--max-hold <초>] [--note <글>] [--base <브랜치>] [--lane <이름>]
#                                        차례가 오면 번호표 ref를 출력하고 0(그 pid가 끝나면 번호표가 지워짐) | 시간 초과 3 | --pid 없음 2 | 실패 1
#   wt queue leave <번호표 ref>           번호표를 지우고, 차례를 쥐고 있었으면 놓는다
#
# 기준: start --base가 branch.<브랜치>.wtBase 에 남긴다(없으면 기본 브랜치). list·gc·finish·overlap이 그것을 쓴다.
# gc가 지우지 않는 브랜치: 기본 브랜치, 어떤 레인의 기준, 원격이 로컬보다 앞선 브랜치, git config wt.protect "v2 release/*"
# 소유 표식: start·claim이 <워크트리 git-dir>/wt-owner 에 세션 ID·claude pid를 남긴다.
# 그 pid가 살아 있는 다른 세션이면 finish·gc가 건드리지 않고, list에 [다른 세션 사용 중]으로 보인다.
# 미반영 커밋을 가진 채 WT_STALE_DAYS(14)일 방치되면 list에 [오래됨]. WT_FORCE_VERIFY=1이면 finish가 늘 검증.
# 자동 묶음: GitHub 대기열의 finish는 기다리는 동안 레인을 준비됨으로 올려 두고, 차례가 오면 다른 준비됨 레인과 함께 머지한다.
# git config wt.autobatch false면 끈다. --priority critical은 묶지도 묶이지도 않는다.
#
# 위치: <저장소>/../<저장소이름>.wt/<슬러그>
# 저장소별 선택 파일(커밋해 두면 모든 워크트리에 적용):
#   .worktreeinclude      새 워크트리로 복사할 gitignore된 파일 패턴(.env 등)
#   .claude/wt-setup.sh   새 워크트리 준비(의존성 설치 등). WT_MAIN=메인 폴더
#   .claude/wt-verify.sh  finish에서 rebase 뒤 실행하는 검증. 실패하면 머지 중단
#   .claude/wt-teardown.sh finish·train·gc --apply가 워크트리를 지우기 직전에 그 안에서 실행. WT_MAIN=메인 폴더. 실패해도 정리는 계속
set -euo pipefail

die() { printf 'wt: %s\n' "$*" >&2; exit 1; }
say() { printf '▸ %s\n' "$*" >&2; }
# 머지 잠금 fd 9(take_lock)를 git·gh에 넘기지 않는다. git이 띄우는 데몬(fsmonitor, 백그라운드 gc 등)이 물려받으면
# wt가 끝난 뒤에도 잠금이 풀리지 않는다. `command git … 9>&-`는 현재 셸에서 fd 9를 fd 10 이상으로 복사해 두었다가
# 되돌리는데, bash 3.2는 그 사본을 자식에게 넘긴다. 서브셸에서 닫고 exec하면 사본이 생기지 않는다(fork 수는 같다).
git() ( exec 9>&-; exec git "$@" )
gh() ( exec 9>&-; exec gh "$@" )

# git 위치 환경(git 훅 안의 GIT_DIR=.git 등)이 있으면 그것으로 저장소·워크트리를 절대 경로로 구해 그리로 옮기고 지운다.
# 남겨 두면 cd(상대 경로가 깨짐)와 git -C <다른 워크트리>도 그 GIT_DIR를 봐 엉뚱한 곳을 다룬다. 인증 변수(GIT_SSH_COMMAND 등)는 그대로.
# GIT_WORK_TREE가 있으면 그것, 없으면 git 폴더에서: 워크트리 git 폴더(<공용>/worktrees/<이름>)는 gitdir 파일, bare는 그 폴더,
# core.worktree가 있으면 그것, 나머지는 부모. 이미 그 워크트리 안이면 자리를 지킨다(그 안의 중첩 워크트리면 맨 위로 옮긴다).
# 현재 폴더가 다른 저장소의 작업 폴더 안이면 옮기지 않고 멈춘다. 저장소를 못 찾으면 그대로 두어 뒤 명령이 지금처럼 오류를 낸다.
if [ -n "${GIT_DIR-}${GIT_WORK_TREE-}${GIT_COMMON_DIR-}${GIT_INDEX_FILE-}${GIT_OBJECT_DIRECTORY-}${GIT_ALTERNATE_OBJECT_DIRECTORIES-}" ] \
  && wt_gd=$(git rev-parse --absolute-git-dir 2>/dev/null); then
  wt_top=""; [ -z "${GIT_WORK_TREE-}" ] || wt_top=$(git rev-parse --show-toplevel 2>/dev/null) || wt_top=""
  unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
  if [ -n "$wt_top" ]; then :
  elif [ -f "$wt_gd/gitdir" ]; then
    wt_top=$(cat "$wt_gd/gitdir"); case $wt_top in /*) ;; *) wt_top=$wt_gd/$wt_top ;; esac; wt_top=$(dirname "$wt_top")
  elif [ "$(git --git-dir="$wt_gd" config --bool core.bare 2>/dev/null)" = true ]; then wt_top=$wt_gd   # git -C <.git>은 core.bare 없으면 bare로 답한다
  elif wt_top=$(git -C "$wt_gd" config core.worktree 2>/dev/null); then   # 하위 모듈(.git/modules/<이름>) 등
    case $wt_top in /*) ;; *) wt_top=$wt_gd/$wt_top ;; esac
  else wt_top=$(dirname "$wt_gd")
  fi
  wt_top=$(cd "$wt_top" && pwd -P) || die "git 위치 환경(GIT_DIR 등)의 저장소 폴더로 옮기지 못했습니다: $wt_top"
  wt_gd=$(cd "$wt_gd" && pwd -P)
  wt_here() { cd "$(git rev-parse --absolute-git-dir 2>/dev/null)" 2>/dev/null && pwd -P; }
  if [ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" = true ] \
    && [ "$(cd "$(git rev-parse --path-format=absolute --git-common-dir)" && pwd -P)" \
      != "$(cd "$(git --git-dir="$wt_gd" rev-parse --path-format=absolute --git-common-dir)" && pwd -P)" ]; then   # git 2.31+
    die "작업 폴더가 git 위치 환경(GIT_DIR 등)과 다른 저장소 안입니다: $(pwd -P) (GIT_DIR 쪽 git 폴더 $wt_gd)"
  fi
  case $(pwd -P)/ in "$wt_top"/*) ;; *) cd "$wt_top" ;; esac
  [ "$(wt_here)" = "$wt_gd" ] || cd "$wt_top"   # 그 워크트리 안의 중첩 워크트리
  [ "$(wt_here)" = "$wt_gd" ] || die "git 위치 환경(GIT_DIR 등)의 워크트리 $wt_top 에서 git이 다른 git 폴더($(wt_here))를 찾습니다(기대 $wt_gd)"
  unset -f wt_here; unset wt_gd wt_top
fi

# 끝날 때(die·Ctrl-C 포함) 쥐고 있는 머지 번호표(q_enter)를 지우고 train의 임시 통합 워크트리를 치운다.
# 머지 잠금은 프로세스가 끝나면 OS가 푼다(take_lock). 신호로 끝날 때도 EXIT 트랩이 돌도록 exit으로 바꾼다.
WT_TMP_WT="" WT_ROOT="" WT_Q_REF="" WT_Q_HEAD="" WT_Q_HB="" WT_Q_USED=""
WT_Q_SELF=$$   # 이 프로세스의 pid. 백그라운드 서브셸에서 $$는 부모 pid라 q_bg가 실제 pid로 바꾼다(bash 3.2엔 BASHPID 없음)
on_exit() {
  # 리다이렉션을 붙이지 않는다: bash 3.2는 원래 fd를 10 이상에 복사해 두는데 그 사이 띄운 정리 프로세스(q_reap_bg)가 사본을 물려받아
  # $(wt queue enter …)로 부른 쪽의 파이프를 최대 30분 붙든다. 경고는 보이고 git 잡음은 q_drop이 버린다.
  # 실패·시간 초과로 끝나는 finish가 올린 준비됨 표식은 지운다(고치는 사이 다른 곳이 옛 내용을 머지하지 않게).
  [ -z "${WT_READY_REF-}" ] || r_clear "$WT_READY_REF" || true
  q_leave || true
  [ -z "$WT_Q_USED" ] || git for-each-ref --format='delete %(refname)' "refs/wt-queue-seen/$$/" 2>/dev/null | git update-ref --stdin 2>/dev/null || true
  [ -z "$WT_TMP_WT" ] || git -C "$WT_ROOT" worktree remove --force "$WT_TMP_WT" 2>/dev/null || true
}
trap on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

git_common_dir() { (cd "$(git rev-parse --git-common-dir)" && pwd -P); }
main_root() { git worktree list --porcelain | sed -n '1s/^worktree //p'; }
has_origin() { git remote get-url origin >/dev/null 2>&1; }
is_github() { has_origin && git remote get-url origin | grep 'github\.com' >/dev/null; }

default_branch() {
  local b
  if has_origin; then
    b=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
    [ -n "$b" ] && { echo "${b#origin/}"; return; }
  fi
  for b in main master; do
    git show-ref --verify --quiet "refs/heads/$b" && { echo "$b"; return; }
  done
  git symbolic-ref --quiet --short HEAD
}

in_linked_worktree() { [ "$(cd "$(git rev-parse --git-dir)" && pwd -P)" != "$(git_common_dir)" ]; }

# 브랜치 내용이 이미 base에 들어가 있는가(squash 머지 포함).
content_in_base() {
  local base=$1 br=$2 tree
  git merge-base --is-ancestor "$br" "$base" && return 0
  # rebase·cherry-pick된 사본: 모든 커밋과 같은 patch-id가 base에 있다.
  # pipefail 아래에서 grep -q/head처럼 일찍 끝나는 소비자는 생산자를 SIGPIPE(141)로 죽여
  # 파이프라인 전체가 실패로 판정된다 — 이 파일의 파이프는 입력을 끝까지 읽는 형태만 쓴다.
  ! git cherry "$base" "$br" | grep '^+' >/dev/null && return 0
  tree=$(git merge-tree --write-tree "$base" "$br" 2>/dev/null | sed -n 1p) || return 1
  [ "$tree" = "$(git rev-parse "$base^{tree}")" ]
}

# 브랜치의 기준: wt start --base가 남긴 branch.<브랜치>.wtBase, 없으면 기본 브랜치.
lane_base() { { [ -n "${1-}" ] && git config "branch.$1.wtBase"; } || default_branch; }
# 기준과 비교할 ref: origin/<기준> → 로컬 <기준> → (기준 브랜치가 사라졌으면) 기본 브랜치.
base_ref() {
  local b=$1
  if ! git show-ref --verify --quiet "refs/remotes/origin/$b" && ! git show-ref --verify --quiet "refs/heads/$b"; then
    b=$(default_branch)
  fi
  if has_origin && git show-ref --verify --quiet "refs/remotes/origin/$b"; then echo "origin/$b"; else echo "$b"; fi
}
# gc가 지우지 않는 기준 브랜치: 기본 브랜치, 어떤 브랜치의 wtBase, 원격이 로컬보다 앞선 브랜치(다른 기준으로 쓰는 장기 브랜치),
# git config wt.protect의 공백 구분 패턴(예: "v2 release/*"). 패턴이 파일 이름으로 펼쳐지지 않게 서브셸에서 set -f.
is_base_branch() (
  set -f
  b=$1
  [ "$b" = "$(default_branch)" ] && exit 0
  git config --get-regexp '^branch\..*\.wtbase$' | awk '{print $2}' | grep -Fx -- "$b" >/dev/null && exit 0
  git show-ref --verify --quiet "refs/remotes/origin/$b" && [ "$(git rev-list --count "$b..origin/$b")" -gt 0 ] && exit 0
  for p in $(git config wt.protect || true); do case $b in $p) exit 0 ;; esac; done
  exit 1
)

# ── 세션 소유 표식 ─────────────────────────────────────────────
# 워크트리마다 <워크트리 git-dir>/wt-owner 에 "session pid 시각"을 남긴다.
# pid는 이 명령을 부른 claude 프로세스. 살아 있으면 그 세션이 쓰는 중으로 본다.
# 워크트리를 지우면 git-dir째 사라지므로 따로 치울 것이 없다.
my_session() { printf '%s' "${WT_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}"; }
claude_pid() {
  local p=$$ c
  while [ -n "$p" ] && [ "$p" -gt 1 ]; do
    c=$(ps -o comm= -p "$p" 2>/dev/null) || return 0
    [ "${c##*/}" = claude ] && { echo "$p"; return; }
    p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
  done
}
owner_file() { echo "$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null)/wt-owner"; }
write_owner() {
  local f; f=$(owner_file "$1")
  printf '%s %s %s\n' "$(my_session)" "${WT_CLAUDE_PID:-$(claude_pid)}" "$(date +%Y-%m-%dT%H:%M)" >"$f"
}
pid_alive() { [ -n "$1" ] && [ "$1" != - ] && kill -0 "$1" 2>/dev/null && [ "$(basename "$(ps -o comm= -p "$1" 2>/dev/null)")" = claude ]; }
# 출력: mine | other <pid> <시각> | stale | none
owner_state() {
  local f s p t; f=$(owner_file "$1")
  [ -f "$f" ] || { echo none; return; }
  read -r s p t <"$f" || true
  if [ -n "$s" ] && [ "$s" = "$(my_session)" ]; then echo mine; return; fi
  if pid_alive "$p"; then echo "other $p $t"; else echo stale; fi
}
# 하네스(Agent isolation: "worktree")가 건 잠금 "claude agent … (pid N …)"의 N이 살아 있는 다른 claude면 그 세션 에이전트가 쓰는 중이다.
agent_lock_state() {
  local lp; lp=$(git -C "$(main_root)" worktree list --porcelain | awk -v w="worktree $1" '$0==w{f=1;next} /^worktree /{f=0} f&&/^locked/&&!d{print;d=1}' | sed -nE 's/.*claude agent .*\(pid ([0-9]+).*/\1/p')
  [ -n "$lp" ] || { echo none; return; }
  if [ "$lp" = "${WT_CLAUDE_PID:-$(claude_pid)}" ]; then echo mine; elif pid_alive "$lp"; then echo "other $lp"; else echo stale; fi
}
# 마지막 활동(브랜치 마지막 커밋, 워크트리면 git-dir·최상위 항목 수정 시각 중 최신) 이후 지난 일수.
idle_days() {
  local b=$1 w=${2-} last m gd
  last=$(git log -1 --format=%ct "$b" 2>/dev/null || echo 0)
  if [ -n "$w" ]; then
    gd=$(git -C "$w" rev-parse --absolute-git-dir 2>/dev/null || true)
    # 사라진 워크트리·BSD find(-printf 없음)에서도 list를 멈추지 않게 실패는 무시한다(커밋 시각만 쓴다).
    m=$(find ${gd:+"$gd"} "$w" -maxdepth 1 -printf '%T@\n' 2>/dev/null | sort -n | tail -n 1 | cut -d. -f1) || m=""
    [ -n "$m" ] && [ "$m" -gt "$last" ] && last=$m
  fi
  echo $(( ($(date +%s) - last) / 86400 ))
}
# main에 없는 커밋을 가진 채 WT_STALE_DAYS(기본 14)일 넘게 손대지 않은 항목 표시. 자동 삭제는 하지 않는다.
stale_label() {
  local d; d=$(idle_days "$@")
  [ "$d" -ge "${WT_STALE_DAYS:-14}" ] && echo " [오래됨 ${d}일 — 사용자에게 정리 여부 확인]"
  return 0
}
# <저장소>.wt/ 밖의 워크트리(배포용 사본 등)는 wt가 만든 작업 레인이 아니다.
wt_managed() { case $1 in "$(dirname "$(main_root)")/$(basename "$(main_root)").wt/"*) return 0 ;; *) return 1 ;; esac; }
owner_label() {
  case $1 in
    mine) echo " [이 세션]" ;;
    other*) set -- $1; echo " [다른 세션 사용 중 pid $2, $3부터]" ;;
    stale) echo " [주인 세션 종료됨]" ;;
    *) echo "" ;;
  esac
}

# ── 레인 간 겹침·충돌 예고 ────────────────────────────────────
# union 머지 파일(기록 등)은 충돌하지 않으니 뺀다(표준 입력의 경로 목록을 거른다).
drop_union() { git check-attr --stdin merge | awk '{ v=$NF; sub(/: merge: [^:]*$/, ""); if (v != "union") print }'; }
# 워크트리(또는 브랜치)가 기준 이후 바꾼 파일 + 미커밋 변경.
lane_files() {
  local ref=$1 w=$2 b=$3 mb
  {
    if [ -n "$b" ] && mb=$(git merge-base "$ref" "$b" 2>/dev/null); then git diff --name-only "$mb" "$b"; fi
    [ -n "$w" ] && git -C "$w" status --porcelain 2>/dev/null | sed 's/^...//; s/.* -> //'
  } | sed '/^$/d' | sort -u | drop_union
}
# 레인 내용(브랜치 + 미커밋 추적 파일 변경)을 커밋 하나로. 그 워크트리의 index는 건드리지 않게 사본으로 만든다
# (다른 세션이 쓰는 중일 수 있다). 미커밋이 없거나 실패하면 브랜치를 그대로 낸다.
lane_snap() {
  local w=$1 b=$2 idx t
  if [ -n "$(git -C "$w" status --porcelain --untracked-files=no 2>/dev/null)" ] && idx=$(mktemp); then
    if cp "$(git -C "$w" rev-parse --absolute-git-dir)/index" "$idx" \
      && t=$(GIT_INDEX_FILE=$idx git -C "$w" add -u 2>/dev/null && GIT_INDEX_FILE=$idx git -C "$w" write-tree); then
      rm -f "$idx"
      GIT_AUTHOR_NAME=wt GIT_AUTHOR_EMAIL=wt GIT_COMMITTER_NAME=wt GIT_COMMITTER_EMAIL=wt git commit-tree "$t" -p "$b" -m wt-snapshot
      return
    fi
    rm -f "$idx"
  fi
  echo "$b"
}
merge_tree_ok() { git merge-tree --write-tree --name-only --no-messages HEAD HEAD >/dev/null 2>&1; }
# 두 커밋을 미리 합쳐(작업 폴더는 그대로) 충돌할 파일을 낸다. 합칠 수 없으면(git 2.38 미만 등) 2.
conflict_files() {
  local out rc=0
  out=$(git merge-tree --write-tree --name-only --no-messages "$1" "$2" 2>/dev/null) || rc=$?
  case $rc in 0) return 0 ;; 1) printf '%s\n' "$out" | sed '1d; /^$/d' | sort -u | drop_union ;; *) return 2 ;; esac
}

# 워크트리 하나를 같은 기준의 다른 레인·기준 브랜치와 미리 합쳐 본다. 보일 것이 있으면 1.
# 두 번째 인자: brief = 한 줄 요약, conflicts = 충돌만. 기준이 다른 레인끼리는 서로 머지되지 않으니 보지 않는다.
show_overlap() {
  local me=$1 mode=${2-} root mybr mybase myref mine snap="" mt=1 buf="" nc=0 na=0 nf=0 nw=0 nb=0
  root=$(main_root)
  mybr=$(git -C "$me" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  mybase=$(lane_base "$mybr"); myref=$(base_ref "$mybase")
  mine=$(lane_files "$myref" "$me" "$mybr")
  merge_tree_ok || mt=0
  if [ -n "$mine" ] && [ $mt = 1 ]; then
    snap=$(lane_snap "$me" "$mybr")
    local bc; bc=$(conflict_files "$snap" "$myref" || true)
    if [ -n "$bc" ]; then
      nb=$(printf '%s\n' "$bc" | wc -l | tr -d ' ')
      buf+="  충돌 예상 기준 $myref (그사이 들어간 변경과 같은 줄)"$'\n'$(printf '%s\n' "$bc" | sed 's/^/      /')$'\n'
    fi
  fi
  while IFS=$'\t' read -r w b; do
    [ "$w" = "$root" ] || [ "$w" = "$me" ] && continue
    [ "$(lane_base "$b")" = "$mybase" ] || continue
    local theirs common cf who
    theirs=$(lane_files "$myref" "$w" "$b")
    [ -n "$theirs" ] || continue
    who="$w ($b)$(owner_label "$(owner_state "$w")")"
    if [ -z "$mine" ]; then
      # 아직 바꾼 게 없으면(새로 시작) 다른 레인이 쥐고 있는 파일을 알려만 준다.
      nw=$((nw + 1))
      buf+="  작업 중 $who"$'\n'$(printf '%s\n' "$theirs" | sed -n '1,15s/^/      /p')$'\n'
      [ "$(printf '%s\n' "$theirs" | wc -l)" -gt 15 ] && buf+="      …"$'\n'
      continue
    fi
    common=$(comm -12 <(printf '%s\n' "$mine") <(printf '%s\n' "$theirs"))
    [ -n "$common" ] || continue
    if [ $mt = 0 ]; then
      nf=$((nf + 1)); buf+="  겹침 $who"$'\n'$(printf '%s\n' "$common" | sed 's/^/      /')$'\n'
      continue
    fi
    cf=$(conflict_files "$snap" "$(lane_snap "$w" "$b")" || true)
    cf=$(comm -12 <(printf '%s\n' "$cf") <(printf '%s\n' "$common"))
    if [ -n "$cf" ]; then
      nc=$((nc + 1)); buf+="  충돌 예상 $who"$'\n'$(printf '%s\n' "$cf" | sed 's/^/      /')$'\n'
    else
      na=$((na + 1)); buf+="  겹침(자동 병합 가능) $who: $(printf '%s\n' "$common" | sed -n '1,5p' | paste -sd ' ' -)"$'\n'
    fi
  done < <(git worktree list --porcelain | awk '/^worktree /{w=substr($0,10)} /^branch /{print w"\t"substr($0,19)}')
  case $mode in
    conflicts) buf=$(printf '%s' "$buf" | awk '/^  [^ ]/{keep=/^  충돌 예상/} keep') ;;
    brief)
      buf=""
      [ $nc -gt 0 ] && buf+=" · 다른 레인과 충돌 예상 ${nc}곳"
      [ $nb -gt 0 ] && buf+=" · 기준과 충돌 예상 파일 ${nb}개"
      [ $na -gt 0 ] && buf+=" · 겹치지만 자동 병합 가능 ${na}곳"
      [ $nf -gt 0 ] && buf+=" · 같은 파일 겹침 ${nf}곳"
      [ $nw -gt 0 ] && buf+=" · 작업 중 레인 ${nw}곳"
      [ -n "$buf" ] && buf="  ${buf# · } (자세히: wt overlap)" ;;
  esac
  [ -n "$buf" ] || return 0
  printf '%s\n' "${buf%$'\n'}"
  return 1
}

cmd_overlap() {
  git rev-parse --git-dir >/dev/null 2>&1 || die "git 저장소가 아닙니다"
  in_linked_worktree || die "작업 워크트리 안에서 실행하세요"
  local me out; me=$(git rev-parse --show-toplevel)
  if out=$(show_overlap "$me"); then say "다른 레인과 겹치는 파일 없음"; return; fi
  printf '%s\n' "$out"
  merge_tree_ok || { say "위 파일은 다른 레인도 고치는 중입니다(git 2.38 미만이라 줄 단위 판정 없음). 먼저 끝나는 쪽 뒤에 rebase 충돌이 날 수 있습니다"; return; }
  say "충돌 예상: 먼저 끝나는 쪽 뒤에 같은 줄 rebase 충돌. 자동 병합 가능: 같은 파일이지만 줄이 겹치지 않음"
}

cmd_claim() {
  git rev-parse --git-dir >/dev/null 2>&1 || die "git 저장소가 아닙니다"
  in_linked_worktree || die "작업 워크트리 안에서 실행하세요"
  local me st; me=$(git rev-parse --show-toplevel); st=$(owner_state "$me")
  case $st in other*) [ "${1-}" = --force ] || die "다른 세션이 쓰는 중입니다$(owner_label "$st"). 그 세션이 끝났는지 확인 후 wt claim --force" ;; esac
  write_owner "$me"; say "이 세션이 $me 를 맡습니다"
}

# ── 기계 간 선점(origin의 refs/wt-claims/<이름>) ───────────────
# 머지 잠금(flock)은 한 기계 안에서만 줄을 세운다. 여러 기계가 같은 원격에 머지·공개하면 이 선점으로 줄을 세운다.
# 선점 = 부모 없는 빈 트리 커밋(본문 "host=… pid=… at=… note=…")을 빈 lease(--force-with-lease=<ref>:)로 push.
# 서버가 "ref가 없을 때만 만들기"를 원자적으로 판정하므로 동시에 시도해도 하나만 잡는다. 해제는 그 sha에 lease를 건 삭제.
# 낡은 선점(커밋 시각이 --stale초보다 오래됨, 또는 이 기계 host의 끝난 pid)은 경고 뒤 넘겨받는다.
claim_host() { [ -z "${WT_HOST-}" ] || { echo "$WT_HOST"; return; }; hostname -s 2>/dev/null || hostname 2>/dev/null || uname -n; }   # WT_HOST: 시험에서 다른 기계 흉내
# claim_read <ref>: 선점을 읽어 C_SHA·C_CT(커밋 시각 초)·C_BODY(host= 줄)를 채운다. 0 있음, 1 없음, 2 조회 실패.
claim_read() {
  local tmp="refs/wt-claims-seen/$$" rc=0
  if git fetch --quiet --no-tags origin "+$1:$tmp" 2>/dev/null; then
    C_SHA=$(git rev-parse "$tmp") C_CT=$(git log -1 --format=%ct "$tmp")
    C_BODY=$(git log -1 --format=%B "$tmp" | awk '/^host=/&&!d{print;d=1}')
    git update-ref -d "$tmp"
    return 0
  fi
  git ls-remote --exit-code origin "$1" >/dev/null 2>&1 || rc=$?
  [ $rc = 2 ] && return 1
  return 2
}
claim_stale() {
  local h="" p="" rh='(^| )host=([^ ]*)' rp='(^| )pid=([0-9]+)'
  [ $(($(date +%s) - ${C_CT:-0})) -gt "$1" ] && return 0
  [[ $C_BODY =~ $rh ]] && h=${BASH_REMATCH[2]}
  [[ $C_BODY =~ $rp ]] && p=${BASH_REMATCH[2]}
  # kill -0은 권한 오류도 실패로 낸다(다른 사용자의 살아 있는 pid를 끝난 것으로 오판).
  [ -n "$p" ] && [ "$h" = "$(claim_host)" ] && ! ps -p "$p" >/dev/null 2>&1
}
# claim_take <이름> <pid> <메모> <낡음 초>: 0 + sha | 3 + 선점자 줄 | 1 실패(네트워크·권한).
claim_take() {
  local ref="refs/wt-claims/$1" sha rc n
  sha=$(GIT_AUTHOR_NAME=wt GIT_AUTHOR_EMAIL=wt GIT_COMMITTER_NAME=wt GIT_COMMITTER_EMAIL=wt \
    git commit-tree "$(git hash-object -t tree -w /dev/null)" -m "wt claim $1" \
    -m "host=$(claim_host) pid=$2 at=$(date -u +%Y-%m-%dT%H:%M:%SZ) note=${3//$'\n'/ }") || return 1
  for n in 1 2 3; do
    git push --quiet --porcelain --force-with-lease="$ref:" origin "$sha:$ref" >/dev/null 2>&1 && { echo "$sha"; return 0; }
    rc=0; claim_read "$ref" || rc=$?
    [ $rc = 1 ] && continue   # 그사이 풀렸다
    [ $rc = 0 ] || return 1
    if claim_stale "$4"; then
      say "경고: 낡은 선점을 넘겨받습니다($1): sha=$C_SHA $C_BODY"
      git push --quiet --force-with-lease="$ref:$C_SHA" origin ":$ref" >/dev/null 2>&1 || true
      continue
    fi
    echo "sha=$C_SHA $C_BODY"; return 3
  done
  return 1
}
# claim_wait <이름> <기다릴 초> <낡음 초> <pid> <메모>: claim_take를 기다릴 초까지 되풀이한다. 종료 코드는 claim_take와 같다.
claim_wait() {
  local out rc end now said=""
  end=$(($(date +%s) + $2))
  while :; do
    rc=0; out=$(claim_take "$1" "$4" "$5" "$3") || rc=$?
    [ $rc = 3 ] || { [ -z "$out" ] || echo "$out"; return $rc; }
    now=$(date +%s)
    [ "$now" -lt "$end" ] || { echo "$out"; return 3; }
    [ -n "$said" ] || { say "선점 $1 을 다른 곳이 쥐고 있어 최대 $2초 기다립니다: $out"; said=1; }
    sleep $((end - now < 3 ? end - now : 3))
  done
}
# claim_release <이름> <sha>: 0 지움(이미 없음 포함), 1 다른 선점이 쥐고 있음·실패.
claim_release() {
  local ref="refs/wt-claims/$1" out cur
  out=$(git ls-remote origin "$ref") || return 1
  cur=$(printf '%s\n' "$out" | awk -v r="$ref" '$2==r{print $1}')
  [ -n "$cur" ] || return 0
  [ "$cur" = "$2" ] || { say "$ref 은 다른 선점($cur)이 쥐고 있어 남겨 둡니다"; return 1; }
  git push --quiet --force-with-lease="$ref:$2" origin ":$ref" >/dev/null 2>&1
}
claim_name_ok() {
  [[ ${1-} =~ ^[A-Za-z0-9._-]+$ ]] || die "선점 이름은 영문·숫자·. _ - 만: ${1-}"
  git rev-parse --git-dir >/dev/null 2>&1 || die "git 저장소가 아닙니다"
  has_origin || die "origin 원격이 없어 선점할 수 없습니다(선점은 origin의 refs/wt-claims/에 둡니다)"
}

cmd_claim_ref() {
  local name="" wait=0 stale=10800 pid=$PPID note=""
  while [ $# -gt 0 ]; do
    case $1 in
      --wait|--stale|--pid) [[ ${2-} =~ ^[0-9]+$ ]] || die "$1 에는 숫자를 주세요: ${2-}"
        case $1 in --wait) wait=$2 ;; --stale) stale=$2 ;; --pid) pid=$2 ;; esac; shift 2 ;;
      --note) note=${2-}; shift 2 ;;
      -*) die "알 수 없는 옵션: $1" ;;
      *) [ -z "$name" ] || die "사용법: wt claim <이름> [--wait <초>] [--stale <초>] [--pid <pid>] [--note <글>]"; name=$1; shift ;;
    esac
  done
  claim_name_ok "$name"
  local rc=0; claim_wait "$name" "$wait" "$stale" "$pid" "$note" || rc=$?
  [ $rc = 1 ] && die "origin에 선점 $name 을 만들지 못했습니다(네트워크·권한 확인)"
  exit $rc
}
cmd_unclaim() {
  [ $# = 2 ] || die "사용법: wt unclaim <이름> <sha>"
  claim_name_ok "$1"
  claim_release "$1" "$2" || exit 1
}
cmd_claims() {
  git rev-parse --git-dir >/dev/null 2>&1 || die "git 저장소가 아닙니다"
  has_origin || die "origin 원격이 없습니다"
  local ns="refs/wt-claims-seen/$$" r ct body now n=0; now=$(date +%s)
  git fetch --quiet --no-tags origin "+refs/wt-claims/*:$ns/*" || die "origin에서 선점 목록을 읽지 못했습니다"
  while read -r r ct; do
    body=$(git log -1 --format=%B "$r" | awk '/^host=/&&!d{print;d=1}')
    printf '  %s  %s  (%s분 전)\n' "${r#"$ns"/}" "$body" $(((now - ct) / 60))
    git update-ref -d "$r"; n=$((n + 1))
  done < <(git for-each-ref --format='%(refname) %(committerdate:unix)' "$ns/")
  [ $n -gt 0 ] || echo "  선점 없음"
}

# ── 머지 대기열(origin의 refs/wt-queue/<기준>/<번호>) ─────────────
# 여러 기계·프로세스의 머지·공개를 한 줄로 세운다(flock은 한 기계 안에서만). finish·train(GitHub)과 외부 스크립트(wt queue enter)가 쓴다.
# 번호표 = 부모 없는 빈 트리 커밋, 제목 한 줄 "wt-queue host=… pid=… at=… kind=… priority=… lane=… note=…"를 빈 lease로 만든다.
# 번호 = <UTC 밀리초 13자리>-<host>-<pid>라 이름이 겹치지 않고 문자열 순서가 시각 순서다.
# 순서: 차례를 쥔 번호표가 맨 앞, 나머지는 등급(critical → release → normal) 다음 번호. 맨 앞이 된 번호표는 refs/wt-queue/<기준>/_head
# (제목 "wt-queue-head ticket=<번호>")를 빈 lease로 만들어 차례를 쥔다 — 동시에 맨 앞이라 판단해도 하나만 쥐고, 쥔 뒤에는 등급 높은
# 번호표가 와도 밀리지 않는다. 번호표의 pid(finish·train은 wt 자신, wt queue enter는 --pid)가 살아 있는 동안 백그라운드 갱신(q_beat)이
# WT_QUEUE_BEAT(60)초마다 번호표를 새 시각으로 다시 올리고, 그 pid가 끝나면 번호표(와 그 번호표의 _head)를 지운다.
# 낡은 번호표: 마지막 갱신이 30분보다 오래됨, 갱신 표식이 없고 주기 3배 + 시계 여유가 지남(q_stale), 또는 같은 host의 끝난
# pid이면서 마지막 갱신이 갱신 주기의 3배보다 오래됨
# (host 이름이 같은 다른 기계의 살아 있는 번호표를 지우지 않게) → 경고 뒤 lease 삭제. _head가 가리키는 번호표가 없으면 _head도 지운다.
# 기계 시계가 맞아야 한다(번호·나이가 시각이다).
q_base() { echo "${1//\//_}"; }
q_field() { local re="(^| )$1=([^ ]*)"; [[ $2 =~ $re ]] && echo "${BASH_REMATCH[2]}"; return 0; }
q_rank() { case $1 in critical) echo 0 ;; release) echo 1 ;; *) echo 2 ;; esac; }
q_ms() { python3 -I -c 'import time; print(int(time.time() * 1000))' 2>/dev/null || echo "$(date +%s)000"; }
q_commit() { GIT_AUTHOR_NAME=wt GIT_AUTHOR_EMAIL=wt GIT_COMMITTER_NAME=wt GIT_COMMITTER_EMAIL=wt git commit-tree "$(git hash-object -t tree -w /dev/null)" -m "$1"; }
# q_born <번호>: 번호의 생성 시각(초). 0으로 시작해도 10진(bash 3.2는 8진으로 읽다 셸을 끝낸다). 숫자가 아니면 빈 값.
q_born() { case ${1%%-*} in ''|*[!0-9]*) ;; *) echo $((10#${1%%-*} / 1000)) ;; esac; }
# 갱신 표식: 갱신(q_beat)은 제목 note= 앞에 beat=1을 넣어 올리고, 번호표 push에 성공하면 첫 sleep 전에 바로 한 번 올린다.
# 표식 없는 번호표 = 갱신이 한 번도 안 올라감 — 결과를 모른 채 늦게 반영된 push(q_enter가 1, 갱신이 안 뜸)의 고아이거나
# 번호표를 만든 직후 몇 초 안에 끊긴 기계. 이것은 만든 지 갱신 주기 3배 + 시계 여유 WT_QUEUE_SKEW(120)초가 지나면 host와
# 관계없이 낡음(다른 기계를 30분 막지 않게). 옛 판 wt는 표식 없이 갱신하므로 표식이 없어도 커밋 시각이 생성 시각에서 갱신 주기
# 절반 넘게 지났으면 갱신된 것으로 본다(둘 다 만든 기계의 시계; 주기는 모든 기계가 같아야 한다). 30분은 갱신된 번호표에만.
q_beaten() { [ "$(q_field beat "${1%% note=*}")" = 1 ]; }   # note= 뒤 글은 보지 않는다(메모에 beat=1을 써도 속지 않게)
q_stale() { # <마지막 갱신 시각> <제목> <번호>
  local age h p b=${WT_QUEUE_BEAT:-60} c; age=$(($(date +%s) - $1)); c=$(q_born "$3")
  [ "$age" -gt 1800 ] && return 0
  [ "$age" -gt $((3 * b)) ] || return 1
  if [ -n "$c" ] && ! q_beaten "$2" && [ $(($1 - c)) -lt $((b / 2 > 0 ? b / 2 : 1)) ] \
    && [ "$age" -gt $((3 * b + ${WT_QUEUE_SKEW:-120})) ]; then return 0; fi
  h=$(q_field host "$2"); p=$(q_field pid "$2")
  [ -n "$p" ] && [ "$h" = "$(claim_host)" ] && ! ps -p "$p" >/dev/null 2>&1   # kill -0은 권한 오류도 실패로 낸다
}
q_prio_ok() { case $1 in critical|release|normal) ;; *) die "--priority 는 critical·release·normal 중 하나: $1" ;; esac; }

# q_scan <기준(q_base)> <내 번호|"">: 대기열을 읽어 낡은 번호표를 치우고 출력한다. 첫 줄 "<차례 번호> <_head sha> <_head 시각>"
# (없으면 "- - -"), 다음 줄부터 순서대로 "<번호>\t<갱신 시각>\t<제목>". 읽지 못하면 1.
q_scan() {
  local qb=$1 me=$2 ns="refs/wt-queue-seen/$$" all id sha ct subj thr hid="" hsha="" hct="" rows=""
  git fetch --quiet --no-tags --prune origin "+refs/wt-queue/$qb/*:$ns/*" 2>/dev/null || return 1
  # q_drop이 fetch와 지우기 사이에 죽어 남긴 임시 ref(이 기계 것이라 이름의 pid로 판정)를 치운다
  while read -r id; do
    sha=${id#refs/wt-queue-drop/}; ps -p "${sha%%-*}" >/dev/null 2>&1 || git update-ref -d "$id" 2>/dev/null || true
  done < <(git for-each-ref --format='%(refname)' refs/wt-queue-drop/ 2>/dev/null)
  all=$(git for-each-ref --format='%(refname:lstrip=3)%09%(objectname)%09%(committerdate:unix)%09%(contents:subject)' "$ns/")
  while IFS=$'\t' read -r id sha ct subj; do
    [ "$id" = _head ] && { hid=$(q_field ticket "$subj") hsha=$sha hct=$ct; }
  done <<<"$all"
  while IFS=$'\t' read -r id sha ct subj; do
    { [ -n "$id" ] && [ "$id" != _head ]; } || continue
    if [ "$id" != "$me" ] && q_stale "$ct" "$subj" "$id"; then
      say "경고: 낡은 번호표를 지웁니다($qb/$id): ${subj#wt-queue }"
      git push --quiet --force-with-lease="refs/wt-queue/$qb/$id:$sha" origin ":refs/wt-queue/$qb/$id" >/dev/null 2>&1 || true
      continue
    fi
    if [ "$id" = "$hid" ]; then thr='!'; else thr=$(q_rank "$(q_field priority "$subj")"); fi
    rows+="$thr$id"$'\t'"$id"$'\t'"$ct"$'\t'"$subj"$'\n'
  done <<<"$all"
  if [ -n "$hid" ] && ! printf '%s' "$rows" | cut -f2 | grep -Fx -- "$hid" >/dev/null; then
    git push --quiet --force-with-lease="refs/wt-queue/$qb/_head:$hsha" origin ":refs/wt-queue/$qb/_head" >/dev/null 2>&1 || true
    hid="" hsha="" hct=""
  fi
  echo "${hid:--} ${hsha:--} ${hct:--}"
  printf '%s' "$rows" | LC_ALL=C sort | cut -f2-
}

# q_enter <기준> <kind> <priority> <pid> <lane> <note> <갱신 상한 초>: 번호표를 만들고 그 pid에 묶인 갱신(q_beat)을 띄운다. WT_Q_REF에 ref.
q_enter() {
  local qb h id subj sha d; qb=$(q_base "$1"); h=$(claim_host); WT_Q_USED=1
  d=$(git_common_dir) && [ -n "$d" ] || return 1
  id="$(q_ms)-${h//[^A-Za-z0-9.-]/_}-$4"
  subj="wt-queue host=$h pid=$4 at=$(date -u +%Y-%m-%dT%H:%M:%SZ) kind=$2 priority=$3 lane=${5:--} note=${6//[$'\n\t']/ }"
  sha=$(q_commit "$subj") || return 1
  # 서버에는 들어갔는데 실패로 보일 수 있다 — 그 sha일 때만 백그라운드에서 지운다
  git push --quiet --force-with-lease="refs/wt-queue/$qb/$id:" origin "$sha:refs/wt-queue/$qb/$id" >/dev/null 2>&1 \
    || { q_reap_bg "refs/wt-queue/$qb/$id" "" "$sha"; return 1; }
  WT_Q_REF="refs/wt-queue/$qb/$id"
  q_bg "$d" q_beat "$WT_Q_REF" "$sha" "$subj" "$4" "$7"
  WT_Q_HB=$!
}
# q_bg <git 공용 폴더> <함수> <인자…>: 백그라운드에서 그 폴더로 옮겨 함수를 돈다. 부르는 줄에 리다이렉션을 붙이지 않는다(위 on_exit).
# git 공용 폴더에서: 부른 쪽 작업 폴더(워크트리)가 나중에 지워져도 git을 쓸 수 있게. git 위치 환경은 시작 때 이미 지웠다
# (맨 위) — 아래 unset은 그것에 기대지 않는 이중 안전장치다. 옮긴 폴더에서 git이 스스로 찾는다.
# 출력은 /dev/null(명령 치환으로 부른 쪽이 남은 sleep 때문에 기다리지 않게). 0~2 밖의 열린 fd도 모두 닫는다: 머지 잠금 fd 9,
# 부른 쪽이 연 fd(exec 200>lock 등), INT·TERM 트랩이 셸 함수 git·gh의 리다이렉션 도중에 돌 때 bash 3.2가 10 이상에 보관해 둔 사본.
q_bg() {
  local d=$1; shift
  # 루프 전체에 2>/dev/null을 붙이지 않는다: bash가 원래 stderr를 10 이상에 보관한 채 루프가 그 사본까지 닫아 루프 뒤 stderr가 돌아오지 않는다.
  ( for f in /dev/fd/*; do f=${f##*/}; [ "$f" -gt 2 ] 2>/dev/null && { eval "exec $f>&-" || :; }; done
    WT_Q_SELF=$(exec sh -c 'echo $PPID')   # exec: sh의 부모가 이 서브셸이 된다
    unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
    cd "$d" && "$@" ) >/dev/null 2>&1 &
}
# q_beat <ref> <sha> <제목> <pid> <상한 초>: pid가 살아 있는 동안 번호표를 갱신한다. pid가 끝나면 번호표를 지우고 끝난다.
# 번호표를 받자마자 표식(beat=1) 달린 갱신을 한 번 올리고 그 뒤 주기마다(위 q_stale). 실패하면 다음 주기에 다시.
# 상한(기다림 + 차례를 쥘 최대 시간)이 지나면 갱신을 멈춘다 — 오래 사는 pid를 넘겨도 30분 뒤 낡음으로 풀린다(wt queue에 [갱신 멈춤]).
# push가 실패하면 origin을 다시 본다: 아직 내 sha(또는 조회 실패)면 다음 주기에 다시, 없어졌거나 다른 sha(남이 낡은 것으로
# 지움·wt queue leave)면 끝난다 — lease가 어긋나 되살리지 않는다. 다시 보기도 실패하면 올라갔는지 모르는 sha를 후보(alts)로 기억해
# 다음에 origin이 그중 하나면 내 것으로 본다(--pid가 끝나 지울 때도 후보까지 내 것).
q_beat() {
  local ref=$1 sha=$2 subj=${3/ note=/ beat=1 note=} new cur end alts="" first=1; end=$(($(date +%s) + $5))
  while [ -n "$first" ] || sleep "${WT_QUEUE_BEAT:-60}"; do
    first=""
    if ! ps -p "$4" >/dev/null 2>&1; then q_reap "$ref" "" "$sha$alts" now; exit 0; fi
    [ "$(date +%s)" -lt "$end" ] || exit 0
    new=$(q_commit "$subj") || continue
    if git push --quiet --force-with-lease="$ref:$sha" origin "$new:$ref" >/dev/null 2>&1; then sha=$new alts=""; continue; fi
    cur=$(git ls-remote origin "$ref") || { alts+=" $new"; continue; }
    cur=${cur%%[[:space:]]*}
    [ -n "$cur" ] || exit 0
    case " $new$alts " in *" $cur "*) sha=$cur alts=""; continue ;; esac   # 올라갔는데 실패로 보고된 경우
    [ "$cur" = "$sha" ] || exit 0
  done
}

# q_wait <기준(q_base)> <내 번호> <기다릴 초>: 차례를 쥐면 0(WT_Q_HEAD에 _head sha), 시간 초과 3, 실패 1.
q_wait() {
  local qb=$1 me=$2 end t hid hsha hct rows k n fails=0 next=0 now fid fs since lane
  end=$(($(date +%s) + $3))
  while :; do
    if ! t=$(q_scan "$qb" "$me"); then
      fails=$((fails + 1)); [ $fails -lt 5 ] || return 1
      sleep 5; continue
    fi
    fails=0
    read -r hid hsha hct <<<"${t%%$'\n'*}"
    rows=$(printf '%s\n' "$t" | sed 1d)
    k=$(printf '%s\n' "$rows" | cut -f1 | grep -Fxn -- "$me" | cut -d: -f1) || true
    [ -n "$k" ] || { say "번호표 $qb/$me 가 대기열에서 사라졌습니다(낡은 것으로 지워짐)"; return 1; }
    if [ "$k" = 1 ]; then
      [ "$hid" = "$me" ] && { WT_Q_HEAD=$hsha; return 0; }
      hsha=$(q_commit "wt-queue-head ticket=$me at=$(date -u +%Y-%m-%dT%H:%M:%SZ)") || return 1
      if git push --quiet --force-with-lease="refs/wt-queue/$qb/_head:" origin "$hsha:refs/wt-queue/$qb/_head" >/dev/null 2>&1; then
        WT_Q_HEAD=$hsha; return 0
      fi
      continue   # 그사이 다른 번호표가 차례를 쥐었다
    fi
    # 자동 묶음 finish: 기다리는 동안 차례를 쥔 쪽이 이 레인까지 함께 머지했으면 4
    if [ -n "$WT_Q_HOOK" ] && "$WT_Q_HOOK"; then return 4; fi
    now=$(date +%s)
    [ "$now" -lt "$end" ] || return 3
    if [ "$now" -ge "$next" ]; then
      n=$(printf '%s\n' "$rows" | wc -l | tr -d ' ')
      IFS=$'\t' read -r fid _ fs <<<"${rows%%$'\n'*}"
      if [ "$fid" = "$hid" ]; then since=$hct; else since=$(q_born "$fid"); since=${since:-$now}; fi
      lane=$(q_field lane "$fs"); [ "$lane" != - ] || lane=$(q_field kind "$fs")
      say "머지 순번 $k/$n · 앞: $(q_field host "$fs") $lane($(((now - since) / 60))분째)"
      next=$((now + 60))
    fi
    sleep $((end - now < ${WT_QUEUE_POLL:-5} ? end - now : ${WT_QUEUE_POLL:-5}))
  done
}

# q_drop <번호표 ref> [<_head sha>] [<번호표 sha>]: 번호표를 지우고 차례를 놓는다. _head sha를 모르면 _head가 이 번호표를 가리킬 때만
# 놓는다. 번호표 sha를 주면 그 sha일 때만 지운다(lease). 번호표가 origin에서 사라졌으면 0.
q_drop() {
  # 임시 ref는 q_scan이 읽는 refs/wt-queue-seen/ 밖에(같은 pid의 다른 wt 목록에 보이거나 그쪽 --prune에 지워지지 않게).
  # 지우기 전에 죽으면 남는다 — 이름의 pid(WT_Q_SELF, 백그라운드도 자기 pid)가 끝난 뒤 q_scan이 치운다.
  local ref=$1 h=${1%/*}/_head hs=${2-} tmp="refs/wt-queue-drop/$WT_Q_SELF-$RANDOM" out
  if [ -z "$hs" ] && git fetch --quiet --no-tags origin "+$h:$tmp" 2>/dev/null; then
    [ "$(q_field ticket "$(git log -1 --format=%s "$tmp" 2>/dev/null)")" = "${ref##*/}" ] && hs=$(git rev-parse --verify -q "$tmp")
    git update-ref -d "$tmp" 2>/dev/null
  fi
  git push --quiet ${3:+--force-with-lease="$ref:$3"} origin ":$ref" >/dev/null 2>&1 || true   # 이미 없으면 실패한다 — 아래에서 확인
  [ -z "$hs" ] || git push --quiet --force-with-lease="$h:$hs" origin ":$h" >/dev/null 2>&1 || true
  out=$(git ls-remote origin "$ref" 2>/dev/null) && [ -z "$out" ]
}
# q_reap <번호표 ref> [<_head sha>] [<번호표 sha 후보들(공백 구분)>] [now]: 번호표를 지운다. 실패하면(네트워크가 잠깐 끊김)
# WT_QUEUE_POLL(5)초마다 다시. 지워졌거나(남이 지운 것 포함) sha 후보를 주었는데 origin이 그 밖의 sha거나 상한 WT_QUEUE_REAP(1800초 =
# 낡음 판정)이 지나면 끝난다. sha 후보를 주면 지금 sha에 lease, 안 주면 이름으로 지운다. 지우기만 하고 다시 올리지 않는다.
# _head는 q_drop처럼 내 번호표를 가리킬 때만 lease로 지운다. now가 없으면 한 주기 쉰 뒤 시작한다(방금 실패한 뒤라).
# sha 후보를 주면 처음 빈 결과를 본 뒤 WT_QUEUE_LATE(30)초 동안 더 본다 — 결과를 모르던 번호표 push(빈 lease)는 서버 반영이
# 첫 조회보다 늦을 수 있다. 조회 간격(WT_QUEUE_POLL)과 따로 둔다: 창은 서버 지연의 길이라 간격을 줄여도 줄면 안 된다.
# (갱신 push는 lease가 내 sha라 지워진 뒤에는 반영되지 않는다.) 이름으로 지울 때는 바로 끝난다.
q_reap() {
  local cur end late=""; end=$(($(date +%s) + ${WT_QUEUE_REAP:-1800}))
  [ -n "${4-}" ] || sleep "${WT_QUEUE_POLL:-5}"
  while :; do
    if cur=$(git ls-remote origin "$1"); then
      cur=${cur%%[[:space:]]*}
      if [ -z "$cur" ]; then
        [ -n "${3-}" ] || return 0
        [ -n "$late" ] || late=$(($(date +%s) + ${WT_QUEUE_LATE:-30}))
        [ "$(date +%s)" -lt "$late" ] || return 0
        sleep "${WT_QUEUE_POLL:-5}"; continue
      fi
      if [ -n "${3-}" ]; then case " $3 " in *" $cur "*) ;; *) return 0 ;; esac; fi
      ! q_drop "$1" "${2-}" "${3:+$cur}" || return 0
    fi
    [ "$(date +%s)" -lt "$end" ] || return 0
    sleep "${WT_QUEUE_POLL:-5}"
  done
}
# 갱신을 먼저 멈춘다(정리 중에 번호표를 되살리지 않게). 놓기에 실패하면 부른 pid와 상관없이 백그라운드에서 다시 지운다 —
# 그 pid가 오래 살면 같은 host도 낡음으로 치우지 못해 모든 기계의 머지가 30분 막힌다.
q_leave() {
  [ -n "$WT_Q_REF" ] || return 0
  # 갱신이 이미 스스로 끝났으면 그 pid는 남의 것일 수 있다 — 아직 내 자식일 때만
  [ -z "$WT_Q_HB" ] || [ "$(ps -o ppid= -p "$WT_Q_HB" 2>/dev/null | tr -d ' ')" != "$$" ] || kill "$WT_Q_HB" 2>/dev/null || true
  if ! q_drop "$WT_Q_REF" "$WT_Q_HEAD"; then
    say "경고: 머지 번호표를 지우지 못해 백그라운드에서 다시 지웁니다(최대 $(((${WT_QUEUE_REAP:-1800} + 59) / 60))분, 직접: wt queue leave $WT_Q_REF)"
    q_reap_bg "$WT_Q_REF" "$WT_Q_HEAD"
  fi
  WT_Q_REF="" WT_Q_HEAD="" WT_Q_HB=""
}
# q_reap_bg <q_reap 인자…>: 부른 pid와 상관없이 백그라운드에서 q_reap(q_bg). 경로는 부모에서 먼저 정한다 — 워크트리가 곧 지워질 수 있다.
q_reap_bg() {
  local d; d=$(git_common_dir 2>/dev/null) && [ -n "$d" ] || return 0
  q_bg "$d" q_reap "$@"
}
# finish·train: 번호표를 받아 차례를 기다린다. 시간 초과는 종료 코드 3(번호표는 on_exit가 지운다).
queue_turn() { # <기준> <kind> <priority> <lane> <기다릴 초> [<메모>]
  q_enter "$1" "$2" "$3" $$ "$4" "${6-}" $(($5 + 10800)) || die "origin에 머지 번호표를 만들지 못했습니다(네트워크·권한). 워크트리는 남겨 둠"
  local rc=0; q_wait "$(q_base "$1")" "${WT_Q_REF##*/}" "$5" || rc=$?
  case $rc in
    0) say "머지 차례를 받았습니다(${WT_Q_REF#refs/wt-queue/})" ;;
    4) return 4 ;;   # WT_Q_HOOK: 다른 곳이 함께 머지함
    3) say "머지 순번을 $(($5 / 60))분 기다렸지만 차례가 오지 않았습니다. wt queue 로 앞 작업을 확인한 뒤 다시 실행하세요. 워크트리는 남겨 둠"; exit 3 ;;
    *) die "머지 대기열을 쓰지 못했습니다(origin 네트워크·권한). 워크트리는 남겨 둠" ;;
  esac
}
# 차례를 아직 쥐고 있는지(낡은 것으로 넘겨받히지 않았는지) push 직전에 본다.
q_holding() {
  [ "$(git ls-remote origin "${WT_Q_REF%/*}/_head" | cut -f1)" = "$WT_Q_HEAD" ]
}
# 옛 판 호환, 다음 판에서 제거: 대기열 이전 판의 finish·train은 refs/wt-claims/merge-<기준>을 잡고 머지한다.
# 그 선점이 살아 있으면(15분 안, 같은 host면 pid도 살아 있음) 풀릴 때까지 최대 20분 기다린다. 못 읽으면 다시 본다.
# 옛 판이 그사이 머지했을 수 있으니 차례를 받은 직후, 기준을 다시 받는 확인보다 먼저 부른다.
q_old_claim_wait() { # <refs/wt-queue/<기준>>
  local name="merge-${1##*/}" rc said="" end; end=$(($(date +%s) + 1200))
  while :; do
    rc=0; claim_read "refs/wt-claims/$name" || rc=$?
    [ $rc = 1 ] && return 0
    [ $rc = 0 ] && claim_stale 900 && return 0
    [ "$(date +%s)" -lt "$end" ] || die "옛 판 wt의 머지 선점 $name 이 20분 동안 풀리지 않았습니다(wt claims 로 확인). 워크트리는 남겨 둠"
    [ -n "$said" ] || { say "옛 판 wt의 머지 선점 $name 이 살아 있어 풀릴 때까지 기다립니다: ${C_BODY:-조회 실패}"; said=1; }
    sleep "${WT_QUEUE_POLL:-5}"
  done
}

# ── 준비됨 표식(origin의 refs/wt-ready/<기준>/<슬러그>) ─────────────
# wt ready가 레인을 "검증 끝, 머지만 남음"으로 올려 두면 차례를 쥔 쪽(wt flush, 자동 묶음 wt finish)이 어느 기계 것이든
# 함께 쌓아 검증 한 번으로 머지한다. 표식 = 레인 커밋을 부모로, 같은 트리를 가진 빈 커밋. 제목 한 줄
# "wt-ready branch=… base=… host=… session=… pid=… at=… tree=<검증한 트리> state=ready|conflict|failed [against=<기준 sha>] note=…".
# 표식 하나만 받으면 부모(레인 커밋)까지 오므로 다른 기계의 브랜치를 따로 받지 않는다. 만들기·바꾸기·지우기는 모두 지금 sha에 건 lease.
# 머지한 쪽이 표식과 원격 레인 브랜치를 지우고, 충돌로 뺐거나 묶음 검증이 실패하면 state와 against(그때 기준)를 남긴다.
WT_READY_REF="" WT_READY_SHA="" WT_READY_BASE="" WT_Q_HOOK="" B_NAMES=""
r_ref() { local s=${2#wt/}; echo "refs/wt-ready/$(q_base "$1")/${s//\//_}"; }   # <기준> <브랜치>
r_f() { q_field "$1" "${2%% note=*}"; }   # note= 뒤 글은 보지 않는다
# r_remote <ref>: origin의 지금 sha(없으면 빈 값). 조회 실패 1.
r_remote() { local out; out=$(git ls-remote origin "$1") || return 1; printf '%s\n' "$out" | awk -v r="$1" '$2==r{print $1}'; }
r_commit() { GIT_AUTHOR_NAME=wt GIT_AUTHOR_EMAIL=wt GIT_COMMITTER_NAME=wt GIT_COMMITTER_EMAIL=wt git commit-tree "$1^{tree}" -p "$1" -m "$2"; }
# r_post <기준> <브랜치> <레인 커밋> <메모>: 표식을 만들거나 새로 올린다(이전 상태는 덮는다). WT_READY_REF·WT_READY_SHA에 남긴다.
r_post() {
  local ref sha cur s; ref=$(r_ref "$1" "$2"); s=$(my_session)
  sha=$(r_commit "$3" "wt-ready branch=$2 base=$1 host=$(claim_host) session=${s:--} pid=${WT_CLAUDE_PID:-$(claude_pid)} at=$(date -u +%Y-%m-%dT%H:%M:%SZ) tree=$(git rev-parse "$3^{tree}") state=ready note=${4//[$'\n\t']/ }") || return 1
  cur=$(r_remote "$ref") || return 1
  git push --quiet --force-with-lease="$ref:$cur" origin "$sha:$ref" >/dev/null 2>&1 || return 1
  WT_READY_REF=$ref WT_READY_SHA=$sha
}
# r_clear <ref>: 지금 표식을 상태와 관계없이 지운다(없으면 0).
r_clear() {
  local cur; cur=$(r_remote "$1") || return 1
  [ -z "$cur" ] || git push --quiet --force-with-lease="$1:$cur" origin ":$1" >/dev/null 2>&1
}
# r_mark <ref> <표식 sha> <state> <기준 sha>: 표식이 아직 그 sha일 때만 상태를 바꾼다(주인이 그사이 다시 올렸으면 그대로).
r_mark() {
  local s new; s=$(git log -1 --format=%s "$2")
  new=$(r_commit "$(git rev-parse "$2^")" "${s%% state=*} state=$3 against=$4 note=${s#* note=}") || return 1
  git push --quiet --force-with-lease="$1:$2" origin "$new:$1" >/dev/null 2>&1
}
# r_scan <기준(q_base) 또는 *>: 표식을 받아 만든 순으로 "<기준>/<슬러그>\t<표식 sha>\t<레인 커밋>\t<시각>\t<제목>". 읽지 못하면 1.
r_scan() {
  local ns="refs/wt-ready-seen/$$" spec out
  if [ "$1" = '*' ]; then spec="+refs/wt-ready/*:$ns/*"; else spec="+refs/wt-ready/$1/*:$ns/$1/*"; fi
  git fetch --quiet --no-tags origin "$spec" 2>/dev/null || return 1
  out=$(git for-each-ref --sort=committerdate --format='%(refname:lstrip=3)%09%(objectname)%09%(parent)%09%(committerdate:unix)%09%(contents:subject)' "$ns/")
  git for-each-ref --format='delete %(refname)' "$ns/" | git update-ref --stdin
  [ -z "$out" ] || printf '%s\n' "$out"
}
# r_show <기준(q_base) 또는 *>: 준비됨 레인 줄(목록용). 없으면 빈 출력, 읽지 못하면 1.
r_show() {
  local rows sl sha tip ct subj a m now; now=$(date +%s)
  rows=$(r_scan "$1") || return 1
  [ -n "$rows" ] || return 0
  while IFS=$'\t' read -r sl sha tip ct subj; do
    a=$(r_f against "$subj"); m=""
    case $(r_f state "$subj") in
      conflict) m=" [충돌로 빠짐, 기준 ${a:0:9} — 주인이 wt finish]" ;;
      failed) m=" [묶음 검증 실패, 기준 ${a:0:9} — 주인이 wt finish]" ;;
    esac
    printf '  %s  %s  %s분 전%s  %s\n' "$sl" "$(r_f host "$subj")" $(((now - ct) / 60)) "$m" "${subj#* note=}"
  done <<<"$rows"
}
# 자동 묶음 finish가 차례를 기다리는 동안(q_wait의 WT_Q_HOOK): 내 표식이 사라졌고 내용이 기준에 있으면 0(다른 곳이 함께 머지함).
# 표식이 바뀌었으면(차례를 쥔 쪽이 충돌·검증 실패로 뺌) 알리고 계속 기다린다 — 내 차례에 직접 올려 검증한다.
r_merged() {
  local cur; cur=$(r_remote "$WT_READY_REF") || return 1
  if [ -n "$cur" ]; then
    [ "$cur" = "$WT_READY_SHA" ] && return 1
    WT_READY_SHA=$cur; say "다른 곳의 묶음에서 빠졌습니다(충돌 또는 묶음 검증 실패). 차례가 오면 이 레인만 직접 올려 검증합니다"
    return 1
  fi
  git fetch --quiet origin "$WT_READY_BASE" 2>/dev/null && content_in_base "origin/$WT_READY_BASE" HEAD
}

# stack_one <커밋> <이름> <기준 ref> [<제목>]: 통합 워크트리(WT_TMP_WT)에 그 커밋을 squash 커밋 하나로 얹는다.
# 0 쌓음, 1 충돌(되돌림), 2 이미 기준에 있음. 충돌 밖의 실패는 die.
stack_one() {
  local rc=0 out
  out=$(git -C "$WT_TMP_WT" -c merge.ff=true -c rerere.enabled=false merge --squash "$1" 2>&1) || rc=$?
  if [ $rc != 0 ]; then
    [ -n "$(git -C "$WT_TMP_WT" diff --name-only --diff-filter=U)" ] || die "$2 를 쌓지 못했습니다. 아무것도 머지하지 않았습니다: $out"
    git -C "$WT_TMP_WT" reset --quiet --hard
    return 1
  fi
  git -C "$WT_TMP_WT" diff --cached --quiet && return 2
  git -C "$WT_TMP_WT" commit --quiet -F - <<<"$(squash_message "$3" "${4-}" "$1")" || die "$2 의 커밋을 만들지 못했습니다"
}
tmp_drop() { teardown_worktree "$WT_TMP_WT"; git worktree remove --force "$WT_TMP_WT"; WT_TMP_WT=""; }

# batch_run <기준> <제목> [<내 브랜치> <내 커밋>]: 묶음 머지(wt flush, 자동 묶음 finish). 차례(GitHub 대기열) 또는 잠금을 쥔 뒤 부른다.
# 최신 origin/<기준>의 통합 워크트리에 (내 레인 →) state=ready 표식을 만든 순으로 squash 커밋 하나씩 쌓고(충돌 나는 레인은 빼고 계속),
# 검증을 한 번 돌려(쌓은 트리가 누군가 검증한 트리와 같으면 건너뜀) 한 번에 머지한다(대기열이면 PR rebase 머지, 아니면 기준으로 push —
# 기준이 움직였으면 거절된다). 기준이 움직였으면 다시 쌓는다(5번까지). 머지한 표식·원격 레인 브랜치(머지한 커밋 그대로일 때)는
# 지우고, 뺀 표식은 state=conflict로 남긴다. 다른 기계의 워크트리는 건드리지 않는다. B_NAMES에 머지한 레인 이름.
# 종료 코드: 0 머지, 3 머지했고 충돌로 뺀 레인 있음, 10 쌓을 다른 레인 없음, 11 내 레인을 쌓지 못함(새 기준과 충돌),
# 12 검증 실패(아무것도 머지 안 함, 쌓은 다른 표식은 state=failed). 그 밖의 실패는 die.
batch_run() {
  local base=$1 title=$2 mine=${3-} mytip=${4-} up="origin/$1" qb root try=0 rows sl sha tip ct subj rc i n
  local refs=() shas=() tips=() names=() vts stacked already conflicted tree head upsha tb pr state body cur
  qb=$(q_base "$base"); root=$(main_root)
  while :; do
    try=$((try + 1))
    git fetch --quiet origin "$base" || die "origin/$base 를 받지 못했습니다(네트워크)"
    rows=$(r_scan "$qb") || die "origin에서 준비됨 표식을 읽지 못했습니다(네트워크)"
    n=0 vts=""
    while IFS=$'\t' read -r sl sha tip ct subj; do
      [ -n "$sl" ] && [ "$(r_f state "$subj")" = ready ] || continue
      [ "$(r_f branch "$subj")" != "$mine" ] || continue
      refs[n]="refs/wt-ready/$sl" shas[n]=$sha tips[n]=$tip names[n]=$(r_f branch "$subj"); vts+=" $(r_f tree "$subj")"; n=$((n + 1))
    done <<<"$rows"
    [ $n -gt 0 ] || return 10
    upsha=$(git rev-parse "$up")
    WT_ROOT=$root WT_TMP_WT="$(dirname "$root")/$(basename "$root").wt/.train-$$"
    git worktree add --quiet --detach "$WT_TMP_WT" "$up"
    stacked="" already="" conflicted="" B_NAMES=""
    if [ -n "$mine" ]; then
      rc=0; stack_one "$mytip" "$mine" "$up" "$title" || rc=$?
      [ $rc = 0 ] || { tmp_drop; return 11; }
      B_NAMES=" ${mine#wt/}"; vts+=" $(git rev-parse "$mytip^{tree}")"
    fi
    for ((i = 0; i < n; i++)); do
      rc=0; stack_one "${tips[i]}" "${names[i]}" "$up" || rc=$?
      case $rc in
        0) stacked+=" $i"; B_NAMES+=" ${names[i]#wt/}"; say "쌓음: ${names[i]}" ;;
        1) conflicted+=" $i"; say "충돌로 뺌: ${names[i]}" ;;
        *) already+=" $i"; say "이미 ${base}에 들어 있음: ${names[i]}" ;;
      esac
    done
    head=$(git -C "$WT_TMP_WT" rev-parse HEAD)
    if [ "$head" != "$upsha" ]; then
      # 준비 스크립트는 쌓은 뒤에(의존성을 바꾼 레인도 그 의존성으로 검증되게).
      prepare_worktree "$root" "$WT_TMP_WT" || die "준비 스크립트 실패(통합 워크트리). 아무것도 머지하지 않았습니다"
      tree=$(git -C "$WT_TMP_WT" rev-parse 'HEAD^{tree}')
      if [ -x "$WT_TMP_WT/.claude/wt-verify.sh" ]; then
        if [ "${WT_FORCE_VERIFY:-}" != 1 ] && case " $vts " in *" $tree "*) true ;; *) false ;; esac; then
          say "쌓은 결과가 이미 검증한 트리와 같아 검증을 건너뜁니다(트리 ${tree:0:7}, 다시 돌리려면 WT_FORCE_VERIFY=1)"
        elif ! (cd "$WT_TMP_WT" && run_verify); then
          for i in $stacked; do r_mark "${refs[i]}" "${shas[i]}" failed "$upsha" || true; done
          tmp_drop; return 12
        fi
      fi
      if [ -n "$WT_Q_REF" ]; then
        git fetch --quiet origin "$base" || die "origin/$base 를 받지 못했습니다(네트워크)"
        if ! git merge-base --is-ancestor "$up" "$head"; then
          tmp_drop; [ $try -lt 5 ] || die "${base}가 계속 움직여 머지하지 못했습니다. 잠시 뒤 다시 실행하세요"
          say "검증하는 사이 ${up}이 움직였습니다. 다시 쌓아 검증합니다($((try + 1))/5)"; continue
        fi
        q_holding || die "머지 차례를 잃었습니다(오래 걸려 다른 곳이 낡은 번호표로 넘겨받음). 아무것도 머지하지 않았습니다. 다시 실행하세요"
        tb="wt/batch-$(date +%Y%m%d-%H%M%S)-$$"
        body=$(git -C "$WT_TMP_WT" log --reverse --format='* %s' "$up..HEAD")
        say "push → origin/$tb"
        git push --quiet --force-with-lease="refs/heads/$tb:" origin "$head:refs/heads/$tb" \
          || die "origin/$tb push 실패(같은 이름이 이미 있거나 네트워크). 아무것도 머지하지 않았습니다"
        pr=$(gh pr create --base "$base" --head "$tb" --title "${title:-"batch:$B_NAMES"}" \
          --body "$(printf '%s\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\n' "$body")") && pr=${pr##*/} \
          && [[ $pr =~ ^[0-9]+$ ]] \
          || { git push --quiet --force-with-lease="refs/heads/$tb:$head" origin --delete "$tb" 2>/dev/null || true; die "PR을 만들지 못했습니다(번호 확인 실패: ${pr-}). 아무것도 머지하지 않았습니다"; }
        say "PR #$pr rebase 머지(레인마다 커밋 하나)"
        if ! gh pr merge "$pr" --rebase --match-head-commit "$head"; then
          gh pr close "$pr" --delete-branch >/dev/null 2>&1 || true
          die "머지 실패(rebase 머지 허용 여부·보호 규칙·체크 등). PR #$pr 은 닫았습니다. 아무것도 머지하지 않았습니다"
        fi
        state=$(gh pr view "$pr" --json state --jq .state)
        [ "$state" = MERGED ] || die "PR #$pr 상태가 $state 입니다"
        git push --quiet --force-with-lease="refs/heads/$tb:$head" origin --delete "$tb" 2>/dev/null || true
      else
        # 대기열 없는 원격: 그사이 기준이 움직였으면 빨리 감기가 아니라 거절된다 → 다시 쌓는다.
        if ! git push --quiet origin "$head:refs/heads/$base"; then
          tmp_drop; [ $try -lt 5 ] || die "origin/$base 로 push하지 못했습니다(기준이 계속 움직이거나 네트워크). 아무것도 머지하지 않았습니다"
          say "${up}이 움직였습니다. 다시 쌓아 검증합니다($((try + 1))/5)"; continue
        fi
        ff_base "$head" "$base"
      fi
    fi
    for i in $stacked $already; do
      r_mark_gone "${refs[i]}" "${shas[i]}"
      cur=$(r_remote "refs/heads/${names[i]}") || cur=""
      [ "$cur" != "${tips[i]}" ] || git push --quiet --force-with-lease="refs/heads/${names[i]}:$cur" origin --delete "${names[i]}" >/dev/null 2>&1 || true
    done
    for i in $conflicted; do r_mark "${refs[i]}" "${shas[i]}" conflict "$upsha" || true; done
    tmp_drop
    [ -z "$conflicted" ] || return 3
    return 0
  done
}
# 머지한 표식을 지운다(그 sha일 때만 — 주인이 그사이 새 커밋으로 다시 올렸으면 남긴다).
r_mark_gone() { git push --quiet --force-with-lease="$1:$2" origin ":$1" >/dev/null 2>&1 || true; }

cmd_ready() {
  local cancel=0 note=""
  while [ $# -gt 0 ]; do
    case $1 in
      --cancel) cancel=1; shift ;;
      --note) note=${2-}; shift 2 ;;
      *) die "사용법: wt ready [--note <글>] | wt ready --cancel" ;;
    esac
  done
  git rev-parse --git-dir >/dev/null 2>&1 || die "git 저장소가 아닙니다"
  in_linked_worktree || die "작업 워크트리 안에서 실행하세요"
  has_origin || die "origin 원격이 없어 준비됨 표식을 둘 수 없습니다(혼자 쓰는 저장소는 wt finish·wt train)"
  local dir branch base upstream st
  dir=$(git rev-parse --show-toplevel); cd "$dir"
  branch=$(git symbolic-ref --quiet --short HEAD) || die "브랜치가 없는 상태(detached)입니다"
  base=$(lane_base "$branch")
  if [ $cancel = 1 ]; then
    r_clear "$(r_ref "$base" "$branch")" || die "origin의 준비됨 표식을 지우지 못했습니다(네트워크)"
    say "준비됨 표식을 지웠습니다: $branch"; return
  fi
  [ -z "$(git status --porcelain)" ] || die "커밋하지 않은 변경이 있습니다. 먼저 커밋하세요"
  [ -d "$(git rev-parse --git-path rebase-merge)" ] || [ -d "$(git rev-parse --git-path rebase-apply)" ] \
    && die "rebase가 진행 중입니다. 충돌을 풀고 git rebase --continue 후 다시 실행하세요"
  st=$(owner_state "$dir")
  case $st in other*) [ "${WT_FORCE_FINISH:-}" = 1 ] || die "다른 세션이 쓰는 워크트리입니다$(owner_label "$st")" ;; esac
  git fetch --quiet origin "$base" || die "origin/$base 를 받지 못했습니다(네트워크)"
  upstream="origin/$base"
  [ "$(git rev-list --count "$upstream..HEAD")" != 0 ] || die "${base}에 새로 들어갈 커밋이 없습니다(정리는 wt finish)"
  content_in_base "$upstream" HEAD && die "이미 ${base}에 반영된 레인입니다(정리는 wt finish)"
  onto_upstream "$upstream" "$dir" "$branch"
  verify_if_changed
  push_lane "$branch"
  r_post "$base" "$branch" HEAD "$note" || die "origin에 준비됨 표식을 올리지 못했습니다(네트워크·권한)"
  WT_READY_REF=""   # 성공한 표식은 남긴다(on_exit가 지우지 않게)
  say "준비됨: $(r_ref "$base" "$branch") (트리 $(git rev-parse --short 'HEAD^{tree}')). 차례를 쥔 wt finish·wt flush가 함께 머지합니다. 머지되면 이 워크트리는 wt finish·wt gc로 정리"
}

cmd_flush() {
  local base="" title="" prio=normal wait=3600
  while [ $# -gt 0 ]; do
    case $1 in
      --base) base=${2-}; shift 2 ;;
      --title) title=${2-}; shift 2 ;;
      --priority) prio=${2-}; q_prio_ok "$prio"; shift 2 ;;
      --wait) [[ ${2-} =~ ^[0-9]+$ ]] || die "--wait 에는 숫자를 주세요: ${2-}"; wait=$2; shift 2 ;;
      *) die "사용법: wt flush [--base <브랜치>] [--title <제목>] [--priority …] [--wait <초>]" ;;
    esac
  done
  git rev-parse --git-dir >/dev/null 2>&1 || die "git 저장소가 아닙니다"
  has_origin || die "origin 원격이 없습니다(준비됨 표식은 origin에 둡니다). 혼자 쓰는 저장소는 wt train"
  local root rows; root=$(main_root); cd "$root"
  [ -n "$base" ] || base=$(default_branch)
  rows=$(r_scan "$(q_base "$base")") || die "origin에서 준비됨 표식을 읽지 못했습니다(네트워크)"
  printf '%s\n' "$rows" | grep -F ' state=ready ' >/dev/null || { say "${base}에 준비된 레인이 없습니다"; return 0; }
  if is_github && type -P gh >/dev/null; then
    queue_turn "$base" train "$prio" "" "$wait" flush
    q_old_claim_wait "${WT_Q_REF%/*}"   # 옛 판 호환, 다음 판에서 제거
  else
    take_lock
  fi
  local rc=0; batch_run "$base" "$title" || rc=$?
  case $rc in
    0|3) ;;
    10) say "${base}에 준비된 레인이 없습니다(다른 곳이 먼저 머지함)"; return 0 ;;
    12) die "묶음 검증 실패. 아무것도 머지하지 않았습니다. 쌓은 레인의 표식에 실패를 남겼습니다(주인이 그 워크트리에서 wt finish로 각자 검증·머지)" ;;
    *) die "묶음 머지 실패(종료 코드 $rc)" ;;
  esac
  q_leave
  sync_main "$root" "$base"
  say "머지 완료 → $base:${B_NAMES:- 없음}. 레인 워크트리는 각 기계의 wt finish·wt gc가 정리합니다"
  [ $rc = 0 ] || { say "충돌로 뺀 레인은 표식에 남겼습니다(wt queue 로 확인, 주인이 그 워크트리에서 wt finish)"; exit 3; }
}

cmd_queue() {
  git rev-parse --git-dir >/dev/null 2>&1 || die "git 저장소가 아닙니다"
  has_origin || die "origin 원격이 없습니다(대기열은 origin의 refs/wt-queue/에 둡니다)"
  local sub=list; case ${1-} in enter|leave|list) sub=$1; shift ;; esac
  local base="" kind="" prio="" wait=3600 pid="" note="" lane="" hold=10800
  if [ $sub = leave ]; then
    [ $# = 1 ] && [[ $1 =~ ^refs/wt-queue/[A-Za-z0-9._-]+/[0-9]+-[A-Za-z0-9._-]+$ ]] || die "사용법: wt queue leave refs/wt-queue/<기준>/<번호>"
    q_drop "$1" || { q_reap_bg "$1"; die "번호표 $1 을 지우지 못했습니다(origin 네트워크·권한). 백그라운드에서 다시 지웁니다"; }
    return
  fi
  while [ $# -gt 0 ]; do
    case $1 in
      --wait|--pid|--max-hold) [[ ${2-} =~ ^[0-9]+$ ]] || die "$1 에는 숫자를 주세요: ${2-}"
        case $1 in --wait) wait=$2 ;; --pid) pid=$2 ;; --max-hold) hold=$2 ;; esac; shift 2 ;;
      --priority) prio=${2-}; q_prio_ok "$prio"; shift 2 ;;
      --base|--note|--lane) case $1 in --base) base=${2-} ;; --note) note=${2-} ;; --lane) lane=${2-} ;; esac; shift 2 ;;
      -*) die "알 수 없는 옵션: $1" ;;
      *) [ $sub = enter ] && [ -z "$kind" ] || die "사용법: wt queue [enter <merge|train|release> …|leave <번호표>]"; kind=$1; shift ;;
    esac
  done
  [ -n "$base" ] || base=$(default_branch)
  [[ $lane =~ ^[A-Za-z0-9._/-]*$ ]] || die "--lane 은 영문·숫자·. _ - / 만: $lane"
  if [ $sub = enter ]; then
    case $kind in merge|train|release) ;; *) die "kind 는 merge·train·release 중 하나: ${kind:-(없음)}" ;; esac
    # --pid 필수: 기본값($PPID)은 $(wt queue enter …) 서브셸이라 곧 끝나 번호표가 바로 지워진다.
    [ -n "$pid" ] || { printf 'wt: 사용법: wt queue enter <kind> --pid <차례를 쥘 프로세스, 보통 $$> […]\n' >&2; exit 2; }
    # init(1)·끝난 pid는 받지 않는다(init은 끝나지 않아 차례가 풀리지 않는다).
    { [ "$pid" -gt 1 ] && ps -p "$pid" >/dev/null 2>&1; } || { printf 'wt: --pid %s 는 살아 있는 프로세스(1보다 큰 pid)여야 합니다\n' "$pid" >&2; exit 2; }
    [ -n "$prio" ] || { prio=normal; [ "$kind" = release ] && prio=release; }
    q_enter "$base" "$kind" "$prio" "$pid" "$lane" "$note" $((wait + hold)) || die "origin에 번호표를 만들지 못했습니다(네트워크·권한)"
    local rc=0; q_wait "$(q_base "$base")" "${WT_Q_REF##*/}" "$wait" || rc=$?
    case $rc in
      # 번호표와 갱신은 남긴다: --pid가 살아 있는 동안 갱신되고, 끝나면 갱신이 지운다(보통은 wt queue leave로 놓는다).
      0) echo "$WT_Q_REF"; WT_Q_REF="" WT_Q_HB="" ;;
      3) say "${wait}초 기다렸지만 차례가 오지 않았습니다(번호표는 지웁니다)"; exit 3 ;;
      *) die "머지 대기열을 쓰지 못했습니다(origin 네트워크·권한)" ;;
    esac
    return
  fi
  local qb t hid hct rows id ct subj i=0 now lane2 mark born; qb=$(q_base "$base"); WT_Q_USED=1; now=$(date +%s)
  t=$(q_scan "$qb" "") || die "origin에서 대기열을 읽지 못했습니다"
  read -r hid _ hct <<<"${t%%$'\n'*}"; rows=$(printf '%s\n' "$t" | sed 1d)
  echo "머지 대기열 $base:"
  [ -n "$rows" ] || echo "  비어 있음"
  [ -z "$rows" ] || while IFS=$'\t' read -r id ct subj; do
    i=$((i + 1)); mark=""
    if [ "$id" = "$hid" ]; then
      mark=" [차례]"; [ $((now - hct)) -le 3600 ] || mark=" [차례 $(((now - hct) / 60))분째 쥠 — 오래 쥔 차례]"
    fi
    [ $((now - ct)) -le $((3 * ${WT_QUEUE_BEAT:-60})) ] || mark+=" [갱신 멈춤 $(((now - ct) / 60))분]"
    lane2=$(q_field lane "$subj"); [ "$lane2" != - ] || lane2=""
    born=$(q_born "$id"); born=${born:-$now}
    printf '  %d. %s  %s  %s %s (%s분째)%s  %s  %s\n' $i "$(q_field priority "$subj")" "$(q_field host "$subj")" "$(q_field kind "$subj")" \
      "$lane2" $(((now - born) / 60)) "$mark" "refs/wt-queue/$qb/$id" "${subj#*note=}"
  done <<<"$rows"
  echo "준비됨 $base (wt flush·자동 묶음 finish가 함께 머지):"
  t=$(r_show "$qb") || t="  (origin에서 준비됨 표식을 읽지 못했습니다)"
  printf '%s\n' "${t:-  없음}"
}

# 새 워크트리 준비: .worktreeinclude의 gitignore 파일 사본 + .claude/wt-setup.sh. start와 train(통합 워크트리)이 쓴다.
prepare_worktree() {
  local root=$1 dir=$2
  if [ -f "$root/.worktreeinclude" ]; then
    (cd "$root" && git ls-files --others --ignored --exclude-from="$root/.worktreeinclude" --directory) \
      | while IFS= read -r f; do
          f=${f%/}; mkdir -p "$dir/$(dirname "$f")" && cp -R "$root/$f" "$dir/$f" || exit 1
        done || return 1   # || 문맥에서 불려 함수 안 errexit가 꺼지므로 파일마다 직접 확인
  fi
  if [ -x "$dir/.claude/wt-setup.sh" ]; then
    say "준비 스크립트 실행: .claude/wt-setup.sh"
    (cd "$dir" && WT_MAIN="$root" ./.claude/wt-setup.sh 9>&-) || return 1
  fi
}

# 워크트리를 지우기 직전: .claude/wt-teardown.sh(그 워크트리 것, 없으면 메인 폴더 것 — 스크립트가 생기기 전에 만든 레인용).
# setup이 만든 바깥 자원(색인·캐시 등)을 치우는 자리다. 실패해도 워크트리 정리는 막지 않고 경고만 한다.
teardown_worktree() {
  local dir=$1 root s
  root=$(git -C "$dir" worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p')
  for s in "$dir/.claude/wt-teardown.sh" "$root/.claude/wt-teardown.sh"; do
    [ -x "$s" ] || continue
    say "정리 스크립트 실행: .claude/wt-teardown.sh ($dir)"
    (cd "$dir" && WT_MAIN="$root" "$s" 9>&- </dev/null) || say "경고: .claude/wt-teardown.sh 실패 — 워크트리 정리는 계속합니다: $dir"
    return 0
  done
}

cmd_start() {
  local slug="" base=""
  while [ $# -gt 0 ]; do
    case $1 in
      --base) base=$2; shift 2 ;;
      -*) die "알 수 없는 옵션: $1" ;;
      *) slug=$1; shift ;;
    esac
  done
  [ -n "$slug" ] || die "사용법: wt start <슬러그> [--base <브랜치>]"
  [[ $slug =~ ^[A-Za-z0-9._-]+$ ]] || die "슬러그는 영문·숫자·. _ - 만: $slug"
  git rev-parse --git-dir >/dev/null 2>&1 || die "git 저장소가 아닙니다"
  git rev-parse --verify --quiet HEAD >/dev/null || die "커밋이 없는 저장소입니다(첫 커밋은 메인 폴더에서)"

  local root; root=$(main_root)
  cd "$root"
  [ -n "$base" ] || base=$(default_branch)
  local branch="wt/$slug" dir; dir="$(dirname "$root")/$(basename "$root").wt/$slug"
  git show-ref --verify --quiet "refs/heads/$branch" && die "브랜치가 이미 있습니다: $branch (wt list)"
  [ -e "$dir" ] && die "폴더가 이미 있습니다: $dir"
  # 다른 기계가 같은 이름으로 만든 레인과 섞이지 않게: origin에 같은 브랜치가 있으면 거부. 원격을 못 보면 경고만(오프라인).
  if has_origin; then
    local rrc=0; git ls-remote --exit-code origin "refs/heads/$branch" >/dev/null 2>&1 || rrc=$?
    case $rrc in
      0) die "origin에 같은 이름의 브랜치가 이미 있습니다: $branch (다른 기계의 레인일 수 있음). 다른 슬러그로 시작하세요" ;;
      2) ;;
      *) say "경고: origin에 $branch 가 있는지 확인하지 못했습니다(네트워크). 그대로 진행합니다" ;;
    esac
  fi

  local from=$base
  if has_origin; then
    git fetch --quiet origin "$base" && from="origin/$base"
  fi
  mkdir -p "$(dirname "$dir")"
  git worktree add --quiet --no-track -b "$branch" "$dir" "$from"
  git -C "$dir" config "branch.$branch.wtBase" "$base"
  prepare_worktree "$root" "$dir" || die "준비 스크립트 실패(워크트리는 남겨 둠: $dir)"
  write_owner "$dir"
  say "워크트리: $dir  (브랜치 $branch ← $from)"
  local others
  if ! others=$(show_overlap "$dir"); then
    say "다른 레인이 작업 중인 파일(같은 파일을 고치면 나중에 rebase 충돌, 주제가 겹치면 그 레인에 합칠지 먼저 판단):"
    printf '%s\n' "$others" >&2
  fi
  echo "$dir"
}

# 레인 브랜치를 origin에 올린다. 원격에 같은 이름이 있으면 이 레인이 마지막으로 올린 sha(branch.<b>.wtPushed)이거나
# HEAD의 조상일 때만 그 sha를 기대값으로 덮어쓴다(rebase 뒤 재푸시). 그 밖은 다른 기계의 같은 이름 레인으로 보고 멈춘다.
# 원격에 없으면 빈 기대값(없을 때만 만들기). 추적 ref(origin/<b>)는 남의 것을 받아 둔 것일 수 있어 기대값으로 쓰지 않는다.
push_lane() {
  local b=$1 out remote mine
  out=$(git ls-remote origin "refs/heads/$b") || die "origin/$b 를 확인하지 못했습니다(네트워크). 워크트리는 남겨 둠"
  remote=$(printf '%s\n' "$out" | awk -v r="refs/heads/$b" '$2==r{print $1}')
  mine=$(git config "branch.$b.wtPushed" || true)
  if [ -n "$remote" ] && [ "$remote" != "$mine" ] && ! git merge-base --is-ancestor "$remote" HEAD 2>/dev/null; then
    die "origin/$b 가 이 레인이 올린 것이 아닙니다(다른 기계의 같은 이름 레인일 수 있음, $remote). 덮어쓰지 않습니다. 새 이름으로 wt start 해 커밋을 옮긴 뒤 finish하세요. 워크트리는 남겨 둠"
  fi
  git push --quiet --force-with-lease="refs/heads/$b:$remote" -u origin "$b" \
    || die "origin/$b push 실패(그사이 다른 곳이 같은 이름으로 올렸을 수 있음). 워크트리는 남겨 둠"
  git config "branch.$b.wtPushed" "$(git rev-parse HEAD)"
}

squash_message() {
  local base=$1 title=$2 head=${3:-HEAD} n
  n=$(git rev-list --count "$base..$head")
  if [ "$n" = 1 ]; then git log -1 --format=%B "$head"; return; fi
  [ -n "$title" ] || title=$(git log --reverse --format=%s "$base..$head" | sed -n 1p)
  printf '%s\n\n' "$title"
  git log --reverse --format='* %s%n%n%b' "$base..$head" | grep -v '^Co-Authored-By:' | cat -s
  git log --format='%(trailers:key=Co-Authored-By,valueonly=false)' "$base..$head" | sort -u | sed '/^$/d'
}

# .claude/wt-verify.sh를 돌리고, 통과하면 그 코드의 트리 해시를 <워크트리 git-dir>/wt-verified 에 남긴다.
# 트리가 같으면 내용이 같으므로 finish는 그 검증을 다시 돌리지 않는다.
verified_file() { echo "$(git rev-parse --absolute-git-dir)/wt-verified"; }
run_verify() {
  say "검증 스크립트 실행: .claude/wt-verify.sh"
  ./.claude/wt-verify.sh 9>&- || return 1
  git rev-parse 'HEAD^{tree}' >"$(verified_file)"
}
cmd_verify() {
  git rev-parse --git-dir >/dev/null 2>&1 || die "git 저장소가 아닙니다"
  in_linked_worktree || die "작업 워크트리 안에서 실행하세요"
  cd "$(git rev-parse --show-toplevel)"
  [ -x .claude/wt-verify.sh ] || die "검증 스크립트(.claude/wt-verify.sh)가 없습니다"
  [ -z "$(git status --porcelain)" ] || die "커밋하지 않은 변경이 있습니다. 커밋한 코드만 검증 기록을 남깁니다"
  run_verify || die "검증 실패"
  say "검증 통과(트리 $(git rev-parse --short 'HEAD^{tree}')). rebase 뒤에도 코드가 같으면 wt finish가 검증을 건너뜁니다"
}

# 동시에 끝나는 작업끼리 머지를 한 줄로 세운다(finish·train 공용). <git-common-dir>/wt-merge.lock 에 flock을
# 이 셸의 fd 9로 건다. 어떻게 끝나든(강제 종료 포함) OS가 풀어 주므로 멈춘 잠금이 남지 않고, 쥔 쪽이 살아 있는 동안은
# 얼마든 기다린다. 오래 살 수 있는 자식(검증·준비 스크립트)에는 fd 9를 넘기지 않는다(9>&-). 파일 내용은 안내용 pid뿐.
take_lock() {
  local f waited=0 rc; f="$(git_common_dir)/wt-merge.lock"
  exec 9>>"$f"
  while :; do
    rc=0; python3 -I -c 'import fcntl, sys
try: fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError: sys.exit(75)' || rc=$?
    [ $rc = 0 ] && break
    [ $rc = 75 ] || die "머지 잠금을 걸지 못했습니다(python3·flock 지원 파일 시스템 필요, 종료 코드 $rc)"
    [ $((waited % 60)) = 0 ] && say "다른 finish·train(pid $(cat "$f" 2>/dev/null))이 머지 중이라 기다립니다($((waited / 60))분 경과)"
    waited=$((waited + 1)); sleep 1
  done
  echo $$ >"$f"
}

# GitHub 밖(원격 없음 포함): 로컬 base를 rev로 fast-forward. 그 브랜치를 쥔 워크트리가 있으면 거기서.
ff_base() {
  local rev=$1 base=$2 holder
  holder=$(git worktree list --porcelain | awk -v b="refs/heads/$base" '/^worktree /{w=substr($0,10)} $0=="branch "b{print w}')
  if [ -n "$holder" ]; then
    git -C "$holder" merge --quiet --ff-only "$rev" || die "$holder 의 $base 를 fast-forward 못 함(그 폴더에 겹치는 미커밋 변경). 워크트리는 남겨 둠"
  else
    git merge-base --is-ancestor "$base" "$rev" || die "$base 가 앞서 있습니다. 다시 실행하세요"
    git branch -f "$base" "$rev"
  fi
}

# 머지가 끝난 레인의 워크트리·로컬 브랜치를 지운다.
# Agent(isolation: "worktree")가 만든 워크트리는 "claude agent ..." 사유로 잠겨 있다.
# 머지까지 끝났다는 건 작업이 끝났다는 뜻이므로 그 잠금만 푼다(다른 사유 잠금은 그대로 실패).
# git worktree lock 사유. 안 잠겼으면 빈 문자열, 사유 없이 잠겼으면 "-".
lock_reason() { git worktree list --porcelain | awk -v w="worktree $1" '$0==w{f=1;next} /^worktree /{f=0} f&&/^locked/&&!d{sub(/^locked ?/,""); print ($0=="" ? "-" : $0); d=1}'; }
remove_lane() {
  local dir=$1 branch=$2
  case "$(lock_reason "$dir")" in
    "claude agent"*) git worktree unlock "$dir" ;;
  esac
  teardown_worktree "$dir"
  git worktree remove --force "$dir"
  git branch -D "$branch" >/dev/null
  rmdir "$(dirname "$dir")" 2>/dev/null || true
}

# 메인 폴더가 base에 있으면 origin/base로 fast-forward.
sync_main() {
  local root=$1 base=$2
  has_origin || return 0
  # 머지는 이미 끝났으니 받기 실패로 실패처럼 끝내지 않는다(같은 기계의 finish가 동시에 받으면 잠금에 걸릴 수 있다).
  git fetch --quiet --prune origin || git fetch --quiet --prune origin \
    || { say "경고: 머지는 끝났지만 origin을 다시 받지 못했습니다. 메인 폴더($root)는 git pull --ff-only로 맞추세요"; return 0; }
  if [ "$(git symbolic-ref --quiet --short HEAD || true)" = "$base" ]; then
    git merge --quiet --ff-only "origin/$base" 2>/dev/null \
      || say "경고: 메인 폴더($root)를 origin/$base 로 fast-forward 못 했습니다(미커밋 변경 확인)"
  fi
}

# 레인을 기준 위로 올린다. 레인 안에 합치기 커밋이 있으면 rebase가 커밋을 한 줄로 다시 쌓아 이미 푼 충돌을 또 낸다
# (기준이 그대로여도). squash 머지라 결과는 같으니 기준을 merge로 받는다.
onto_upstream() {
  local upstream=$1 dir=$2 branch=$3
  if git merge-base --is-ancestor "$upstream" HEAD; then
    say "${upstream}이 이미 들어 있어 rebase 없이 진행합니다"
  elif [ -n "$(git rev-list --merges "$upstream..HEAD")" ]; then
    say "합치기 커밋이 있는 레인이라 rebase 대신 ${upstream}을 merge합니다"
    git merge --quiet --no-edit "$upstream" || die "merge 충돌. 이 워크트리($dir)에서 풀고 git commit → wt verify → wt finish 재실행"
  else
    say "rebase: $branch → $upstream"
    git rebase --quiet "$upstream" || die "rebase 충돌. 이 워크트리($dir)에서 풀고 git rebase --continue → wt verify → wt finish 재실행"
  fi
}
# 검증 기록(wt-verified)의 트리와 다르면 .claude/wt-verify.sh를 돌린다.
verify_if_changed() {
  [ -x .claude/wt-verify.sh ] || return 0
  local tree; tree=$(git rev-parse 'HEAD^{tree}')
  if [ "${WT_FORCE_VERIFY:-}" != 1 ] && [ "$(cat "$(verified_file)" 2>/dev/null)" = "$tree" ]; then
    say "이미 검증한 코드와 같아 검증을 건너뜁니다(트리 $(git rev-parse --short "$tree"), 다시 돌리려면 WT_FORCE_VERIFY=1)"
  else
    run_verify || die "검증 실패. 고친 뒤 커밋하고 wt finish 재실행"
  fi
}

cmd_finish() {
  local title="" prio=normal wait=3600
  while [ $# -gt 0 ]; do
    case $1 in
      --title) title=$2; shift 2 ;;
      --priority) prio=${2-}; q_prio_ok "$prio"; shift 2 ;;
      --wait) [[ ${2-} =~ ^[0-9]+$ ]] || die "--wait 에는 숫자를 주세요: ${2-}"; wait=$2; shift 2 ;;
      *) die "알 수 없는 옵션: $1" ;;
    esac
  done
  git rev-parse --git-dir >/dev/null 2>&1 || die "git 저장소가 아닙니다"
  in_linked_worktree || die "메인 폴더가 아니라 작업 워크트리 안에서 실행하세요"
  local dir branch root base
  dir=$(git rev-parse --show-toplevel)
  cd "$dir"   # 하위 폴더에서 실행해도 .claude/wt-verify.sh를 찾게
  branch=$(git symbolic-ref --quiet --short HEAD) || die "브랜치가 없는 상태(detached)입니다"
  root=$(main_root)
  base=$(lane_base "$branch")
  [ -z "$(git status --porcelain)" ] || die "커밋하지 않은 변경이 있습니다. 먼저 커밋하세요"
  [ -d "$(git rev-parse --git-path rebase-merge)" ] || [ -d "$(git rev-parse --git-path rebase-apply)" ] \
    && die "rebase가 진행 중입니다. 충돌을 풀고 git rebase --continue 후 다시 실행하세요"
  local st; st=$(owner_state "$dir")
  case $st in other*) [ "${WT_FORCE_FINISH:-}" = 1 ] || die "다른 세션이 쓰는 워크트리입니다$(owner_label "$st"). 그 세션에서 finish하거나, 끝난 게 확실하면 wt claim --force 후 재실행" ;; esac
  local ov; ov=$(show_overlap "$dir" brief) || say "참고:${ov# }"

  # GitHub면 기계·프로세스 사이 순서는 origin의 머지 대기열이 정한다(rebase·검증은 줄 밖에서 미리). 아니면 이 기계의 flock.
  local queue=0; is_github && type -P gh >/dev/null && queue=1
  [ $queue = 1 ] || take_lock

  local upstream=$base
  if has_origin; then git fetch --quiet origin "$base"; upstream="origin/$base"; fi

  if [ "$(git rev-list --count "$upstream..HEAD")" = 0 ]; then
    say "${base}에 새로 들어갈 커밋이 없습니다. 정리만 합니다"
  elif content_in_base "$upstream" HEAD; then
    say "이미 ${base}에 반영된 레인입니다(다른 곳의 묶음 머지 등). 정리만 합니다"
  else
    onto_upstream "$upstream" "$dir" "$branch"
    verify_if_changed

    if [ $queue = 1 ]; then
      # 자동 묶음(git config wt.autobatch, 기본 켬, critical은 제외): 줄에 서기 전에 레인을 준비됨으로 올려 둔다 — 앞에서 차례를
      # 쥔 finish·flush가 이 레인까지 함께 머지하면 기다리다 알아차리고(q_wait의 WT_Q_HOOK) 정리만 한다. 내 차례가 오면 다른
      # 준비됨 레인을 내 레인과 함께 쌓아 검증 한 번으로 머지한다(batch_run). 묶을 레인이 없거나 묶음이 안 되면 이 레인만.
      local batch=0 qrc=0 brc=10 single=1
      if [ "$prio" != critical ] && [ "$(git config --bool wt.autobatch 2>/dev/null || true)" != false ]; then
        push_lane "$branch"
        if r_post "$base" "$branch" HEAD ""; then batch=1 WT_READY_BASE=$base WT_Q_HOOK=r_merged
        else say "경고: origin에 준비됨 표식을 올리지 못해 다른 레인과 묶지 않습니다"; fi
      fi
      queue_turn "$base" merge "$prio" "$branch" "$wait" || qrc=$?
      WT_Q_HOOK=""
      if [ $qrc = 0 ]; then
        q_old_claim_wait "${WT_Q_REF%/*}"   # 옛 판 호환, 다음 판에서 제거. 기다린 뒤 아래에서 기준을 다시 받는다
        git fetch --quiet origin "$base" || die "origin/$base 를 받지 못했습니다(네트워크). 워크트리는 남겨 둠"
        ! content_in_base "$upstream" HEAD || qrc=4
      fi
      if [ $qrc = 4 ]; then
        say "다른 곳의 묶음 머지에 함께 들어갔습니다($upstream). 정리만 합니다"; single=0
      elif [ $batch = 1 ]; then
        brc=0; batch_run "$base" "$title" "$branch" "$(git rev-parse HEAD)" || brc=$?
        case $brc in
          0|3) single=0; say "묶음 머지 →$B_NAMES"
               [ $brc = 0 ] || say "충돌로 뺀 레인은 표식에 남겼습니다(wt queue 로 확인, 주인이 그 워크트리에서 wt finish)" ;;
          11) say "새 기준 위에 이 레인을 쌓지 못해 묶지 않고 이 레인만 올립니다" ;;
          12) say "묶음 검증이 실패했습니다(함께 쌓은 레인 표식에 기록). 이 레인만 머지합니다" ;;
        esac
      fi
    fi
    if [ $queue = 1 ] && [ $single = 1 ]; then
      # 차례를 받은 뒤 origin/<기준>을 다시 받아 검증한 기준 그대로인지 본다. 움직였으면 차례를 쥔 채 다시 올려 검증한다 —
      # 검증하지 않은 조합을 머지하지 않게. 대기열 밖에서 계속 push하는 곳이 있으면 5번 뒤 멈춘다.
      local try=1
      while :; do
        git fetch --quiet origin "$base" || die "origin/$base 를 받지 못했습니다(네트워크). 워크트리는 남겨 둠"
        git merge-base --is-ancestor "$upstream" HEAD && break
        [ $try -lt 5 ] || die "${base}가 계속 움직여 머지하지 못했습니다. 잠시 뒤 wt finish를 다시 실행하세요. 워크트리는 남겨 둠"
        try=$((try + 1))
        say "검증하는 사이 ${upstream}이 움직였습니다. 다시 올려 검증합니다(${try}/5)"
        onto_upstream "$upstream" "$dir" "$branch"
        verify_if_changed
      done
      q_holding || die "머지 차례를 잃었습니다(오래 걸려 다른 곳이 낡은 번호표로 넘겨받음). wt finish를 다시 실행하세요. 워크트리는 남겨 둠"
      local msg subject body pr state
      msg=$(squash_message "$upstream" "$title")
      # head -1 파이프는 긴 메시지에서 printf가 SIGPIPE(141)로 죽어 pipefail에 걸린다
      subject=${msg%%$'\n'*}
      body=$(printf '%s\n' "$msg" | tail -n +3)
      say "push → origin/$branch"
      push_lane "$branch"
      pr=$(gh pr list --head "$branch" --base "$base" --state open --json number --jq '.[0].number' 2>/dev/null || true)
      if [ -z "$pr" ]; then
        gh pr create --base "$base" --head "$branch" --title "$subject" \
          --body "$(printf '%s\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\n' "$body")" >/dev/null
        pr=$(gh pr list --head "$branch" --base "$base" --state open --json number --jq '.[0].number')
      fi
      say "PR #$pr squash 머지"
      # --match-head-commit: 검증한 커밋이 아닌 것(그사이 다른 곳에서 레인 브랜치에 push)은 머지하지 않는다.
      gh pr merge "$pr" --squash --match-head-commit "$(git rev-parse HEAD)" --subject "$subject" --body "$body" \
        || die "머지 실패(보호 규칙·체크 등). PR #$pr 을 확인하세요. 워크트리는 남겨 둠"
      state=$(gh pr view "$pr" --json state --jq .state)
      [ "$state" = MERGED ] || die "PR #$pr 상태가 $state 입니다. 워크트리는 남겨 둠"
    fi
    if [ $queue = 1 ]; then
      q_leave
      git push --quiet --force-with-lease="refs/heads/$branch:$(git rev-parse HEAD)" origin --delete "$branch" 2>/dev/null || true
    else
      # 원격이 없거나 GitHub가 아닌 저장소: 로컬 squash 후 base를 fast-forward.
      local msg; msg=$(squash_message "$upstream" "$title")
      git reset --soft "$upstream"
      git commit --quiet -F - <<<"$msg"
      if has_origin; then
        git push --quiet origin "HEAD:$base" || die "origin/$base 로 push 실패. 워크트리는 남겨 둠"
      fi
      ff_base "$branch" "$base"
    fi
    say "머지 완료 → $base"
  fi
  # 이 레인의 준비됨 표식(이번 finish가 올린 것, 앞서 wt ready로 올린 것, 다른 곳이 충돌로 표시한 것)을 지운다.
  if has_origin; then r_clear "$(r_ref "$base" "$branch")" || say "경고: origin의 준비됨 표식을 지우지 못했습니다(나중에 wt queue로 확인)"; fi
  WT_READY_REF=""

  cd "$root"
  remove_lane "$dir" "$branch"
  sync_main "$root" "$base"
  say "정리 완료: 워크트리·브랜치 $branch 삭제, 메인 폴더 $root"
}

# 여러 레인을 한 번에: 잠금 한 번 → origin/<기준>의 임시 통합 워크트리에 레인마다 squash 커밋 하나씩 쌓기
# (충돌 나는 레인은 빼고 계속) → 준비·.claude/wt-verify.sh 한 번 → 한 번에 머지(레인별 커밋 유지) → 레인 정리.
# 검증이 실패하면 아무것도 머지하지 않는다. 그때는 레인마다 wt finish(각자 rebase·검증).
# 종료 코드: 0 = 모두 머지·정리, 3 = 충돌로 뺐거나 쌓은 뒤 바뀌어 남긴 레인이 있음(목록 출력).
cmd_train() {
  local title="" args=() prio=normal wait=3600
  while [ $# -gt 0 ]; do
    case $1 in
      --title) title=$2; shift 2 ;;
      --priority) prio=${2-}; q_prio_ok "$prio"; shift 2 ;;
      --wait) [[ ${2-} =~ ^[0-9]+$ ]] || die "--wait 에는 숫자를 주세요: ${2-}"; wait=$2; shift 2 ;;
      -*) die "알 수 없는 옵션: $1" ;;
      *) args+=("$1"); shift ;;
    esac
  done
  [ ${#args[@]} -gt 0 ] || die "사용법: wt train [--title <제목>] <레인>...  (레인 = 슬러그·브랜치·워크트리 경로)"
  git rev-parse --git-dir >/dev/null 2>&1 || die "git 저장소가 아닙니다"
  local here=$PWD root common; root=$(main_root); common=$(git_common_dir); cd "$root"

  # 레인 확인은 잠금 전에 끝낸다: 하나라도 안 되면 아무것도 하지 않는다.
  local dirs=() branches=() base="" a b d p gd lb st
  for a in "${args[@]}"; do
    if git show-ref --verify --quiet "refs/heads/wt/$a"; then b="wt/$a"
    elif git show-ref --verify --quiet "refs/heads/$a"; then b=$a
    elif p=$(cd "$here" && cd "$a" 2>/dev/null && pwd -P); then
      [ "$(cd "$p" && git_common_dir 2>/dev/null)" = "$common" ] || die "이 저장소의 워크트리가 아닙니다: $a"
      b=$(git -C "$p" symbolic-ref --quiet --short HEAD) || die "브랜치가 없는 워크트리입니다: $a"
    else die "레인을 찾지 못했습니다: $a"; fi
    is_base_branch "$b" && die "기준 브랜치이거나 원격 사본이 로컬보다 앞선 브랜치라 묶지 않습니다: $b (레인이면 그 워크트리에서 wt finish)"
    case " ${branches[*]-} " in *" $b "*) die "같은 레인을 두 번 넣었습니다: $b" ;; esac
    d=$(git worktree list --porcelain | awk -v r="branch refs/heads/$b" '/^worktree /{w=substr($0,10)} $0==r{print w}')
    [ -n "$d" ] || die "워크트리가 없는 브랜치입니다: $b"
    [ "$d" != "$root" ] || die "메인 폴더는 레인이 아닙니다: $b"
    [ -z "$(git -C "$d" status --porcelain)" ] || die "커밋하지 않은 변경이 있습니다: $d"
    gd=$(git -C "$d" rev-parse --absolute-git-dir)
    [ -d "$gd/rebase-merge" ] || [ -d "$gd/rebase-apply" ] && die "rebase가 진행 중입니다: $d"
    st=$(owner_state "$d")
    case $st in other*) [ "${WT_FORCE_FINISH:-}" = 1 ] || die "다른 세션이 쓰는 워크트리입니다$(owner_label "$st"): $d" ;; esac
    case $(agent_lock_state "$d") in other*) die "다른 세션 에이전트가 쓰는 워크트리입니다: $d" ;; esac
    case $(lock_reason "$d") in ""|"claude agent"*) ;; *) die "잠긴 워크트리입니다(git worktree lock): $d" ;; esac
    lb=$(lane_base "$b"); [ -n "$base" ] || base=$lb
    [ "$lb" = "$base" ] || die "기준이 다른 레인은 함께 묶지 못합니다: $b(기준 $lb) ≠ 기준 $base"
    dirs+=("$d"); branches+=("$b")
  done

  local queue=0; is_github && type -P gh >/dev/null && queue=1
  [ $queue = 1 ] || take_lock
  local upstream=$base
  if has_origin; then git fetch --quiet origin "$base"; upstream="origin/$base"; fi
  WT_ROOT=$root WT_TMP_WT="$(dirname "$root")/$(basename "$root").wt/.train-$$"
  git worktree add --quiet --detach "$WT_TMP_WT" "$upstream"

  # 레인은 이름이 아니라 지금의 커밋으로 쌓는다(같은 이름 태그·쌓은 뒤 새 커밋과 섞이지 않게). 목록은 배열 번호, 공백 구분.
  local i rc out tips=() stacked="" already="" conflicted=""
  for i in "${!branches[@]}"; do
    b=${branches[$i]}
    tips[$i]=$(git rev-parse --verify --quiet "refs/heads/$b") || { say "그사이 사라진 레인: $b"; continue; }
    rc=0; stack_one "${tips[$i]}" "$b" "$upstream" || rc=$?
    case $rc in
      0) stacked+=" $i"; say "쌓음: $b" ;;
      1) conflicted+=" $i"; say "충돌로 뺌: $b" ;;
      *) already+=" $i"; say "이미 ${base}에 들어 있음: $b" ;;
    esac
  done

  local names=""
  if [ -z "$stacked" ]; then
    say "${base}에 새로 들어갈 레인이 없습니다"
  else
    # 준비 스크립트는 쌓은 뒤에 돌린다(의존성을 바꾼 레인도 그 의존성으로 검증되게).
    prepare_worktree "$root" "$WT_TMP_WT" || die "준비 스크립트 실패(통합 워크트리). 아무것도 머지하지 않았습니다"
    if [ -x "$WT_TMP_WT/.claude/wt-verify.sh" ]; then
      (cd "$WT_TMP_WT" && run_verify) \
        || die "묶음 검증 실패. 아무것도 머지하지 않았습니다. 레인마다 wt finish로 각자 검증·머지하세요"
    fi
    local tip; tip=$(git -C "$WT_TMP_WT" rev-parse HEAD)
    for i in $stacked; do names+=" ${branches[$i]#wt/}"; done
    if [ $queue = 1 ]; then
      local tb subject body pr state
      # 묶음 하나가 번호표 하나. 차례를 받은 뒤 기준이 움직였으면 다시 쌓지 않고 멈춘다(아무것도 push하지 않았고 레인은 그대로).
      queue_turn "$base" train "$prio" "" "$wait" "${names# }"
      q_old_claim_wait "${WT_Q_REF%/*}"   # 옛 판 호환, 다음 판에서 제거. 기다린 뒤 아래에서 기준을 다시 받는다
      git fetch --quiet origin "$base"
      git merge-base --is-ancestor "$upstream" "$tip" \
        || die "검증하는 사이 ${upstream}이 움직여 머지하지 않았습니다. 레인은 그대로입니다. wt train을 다시 실행하세요(다시 쌓아 검증합니다)"
      q_holding || die "머지 차례를 잃었습니다(오래 걸려 다른 곳이 낡은 번호표로 넘겨받음). 레인은 그대로입니다. wt train을 다시 실행하세요"
      tb="wt/train-$(date +%Y%m%d-%H%M%S)-$$"
      subject=${title:-"train:$names"}
      body=$(git -C "$WT_TMP_WT" log --reverse --format='* %s' "$upstream..HEAD")
      say "push → origin/$tb"
      git push --quiet --force-with-lease="refs/heads/$tb:" origin "$tip:refs/heads/$tb" \
        || die "origin/$tb push 실패(같은 이름이 이미 있거나 네트워크). 레인은 그대로입니다"
      # 번호는 create가 낸 URL에서 받는다. 빈 번호를 gh에 주면 메인 폴더 브랜치의 PR을 대상으로 삼는다.
      pr=$(gh pr create --base "$base" --head "$tb" --title "$subject" \
        --body "$(printf '%s\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\n' "$body")") && pr=${pr##*/} \
        && [[ $pr =~ ^[0-9]+$ ]] \
        || { git push --quiet --force-with-lease="refs/heads/$tb:$tip" origin --delete "$tb" 2>/dev/null || true; die "PR을 만들지 못했습니다(번호 확인 실패: ${pr-}). 레인은 그대로입니다"; }
      say "PR #$pr rebase 머지(레인마다 커밋 하나)"
      if ! gh pr merge "$pr" --rebase --match-head-commit "$tip"; then
        gh pr close "$pr" --delete-branch >/dev/null 2>&1 || true
        die "머지 실패(rebase 머지 허용 여부·보호 규칙·체크 등). PR #$pr 은 닫았습니다. 레인은 그대로 — 레인마다 wt finish"
      fi
      state=$(gh pr view "$pr" --json state --jq .state)
      [ "$state" = MERGED ] || die "PR #$pr 상태가 $state 입니다. 레인 워크트리는 남겨 둠"
      q_leave
      git push --quiet --force-with-lease="refs/heads/$tb:$tip" origin --delete "$tb" 2>/dev/null || true
    else
      if has_origin; then
        git push --quiet origin "$tip:refs/heads/$base" || die "origin/$base 로 push 실패. 레인 워크트리는 남겨 둠"
      fi
      ff_base "$tip" "$base"
    fi
    say "머지 완료 → $base:$names"
  fi

  tmp_drop
  has_origin && { git fetch --quiet origin "$base" || say "경고: origin/$base 를 다시 받지 못해 원격 레인 브랜치 정리를 건너뛸 수 있습니다"; }
  local changed=""
  for i in $stacked $already; do
    b=${branches[$i]} d=${dirs[$i]}
    # 쌓은 뒤 레인에 새 커밋·미커밋 변경이 생겼으면 지우지 않는다(그 변경은 아직 머지되지 않았다).
    if [ "$(git rev-parse --verify --quiet "refs/heads/$b" || true)" != "${tips[$i]}" ] \
      || [ -n "$(git -C "$d" status --porcelain 2>/dev/null)" ]; then
      changed+=" $i"; continue
    fi
    remove_lane "$d" "$b"
    # 원격 레인 브랜치는 내용이 기준에 다 들어 있을 때만 지운다(다른 곳에서 더 push했을 수 있다).
    if has_origin && git show-ref --verify --quiet "refs/remotes/origin/$b" && content_in_base "$upstream" "origin/$b"; then
      git push --quiet --force-with-lease="refs/heads/$b:$(git rev-parse "refs/remotes/origin/$b")" origin --delete "$b" 2>/dev/null || true
    fi
  done
  sync_main "$root" "$base"
  say "정리 완료: 머지${names:- 없음}, 메인 폴더 $root"
  [ -n "$conflicted$changed" ] || return 0
  if [ -n "$conflicted" ]; then
    say "충돌로 뺀 레인(그 워크트리에서 wt finish → rebase 충돌을 풀고 각자 머지):"
    for i in $conflicted; do printf '  %s  %s\n' "${dirs[$i]}" "${branches[$i]}" >&2; done
  fi
  if [ -n "$changed" ]; then
    say "쌓은 뒤 새 커밋·미커밋 변경이 생겨 남긴 레인(쌓은 부분은 들어갔음, 남은 변경은 그 워크트리에서 wt finish):"
    for i in $changed; do printf '  %s  %s\n' "${dirs[$i]}" "${branches[$i]}" >&2; done
  fi
  exit 3
}

# list 한 줄의 꼬리: 자기 기준 대비 앞선 커밋 수, [기준 X](기본 브랜치가 아닐 때), [X에 반영됨]/[오래됨]/[기준 브랜치].
branch_status() {
  local b=$1 w=${2-} base ref tag=""
  base=$(lane_base "$b"); ref=$(base_ref "$base")
  [ "$base" = "$(default_branch)" ] || tag=" [기준 $base]"
  printf '+%s%s' "$(git rev-list --count "$ref..$b")" "$tag"
  if is_base_branch "$b"; then printf ' [기준 브랜치]'
  elif content_in_base "$ref" "$b"; then printf ' [%s에 반영됨]' "$base"
  else stale_label "$b" "$w"; fi
}

cmd_list() {
  git rev-parse --git-dir >/dev/null 2>&1 || die "git 저장소가 아닙니다"
  cd "$(main_root)"
  local base; base=$(default_branch)
  printf '기준: %s (다른 기준 레인은 [기준 X])\n' "$(base_ref "$base")"
  git worktree list --porcelain | awk '/^worktree /{w=substr($0,10)} /^branch /{print w"\t"substr($0,19)} /^detached/{print w"\t(detached)"}' |
    while IFS=$'\t' read -r w b; do
      [ "$w" = "$(main_root)" ] && continue
      local st=""; [ -n "$(git -C "$w" status --porcelain 2>/dev/null)" ] && st=" 미커밋변경"
      local mg=""; wt_managed "$w" || mg=" [wt 관리 밖]"
      if [ "$b" = "(detached)" ]; then printf '  워크트리 %s  (detached)%s%s\n' "$w" "$st" "$mg"; continue; fi
      local al=""; case $(agent_lock_state "$w") in other*) al=" [다른 세션 에이전트 실행 중]" ;; mine) al=" [이 세션 에이전트]" ;; esac
      printf '  워크트리 %s  %s  %s%s%s%s%s\n' "$w" "$b" "$(branch_status "$b" "$w")" "$st" "$(owner_label "$(owner_state "$w")")" "$al" "$mg"
    done
  git for-each-ref --format='%(refname:short)' refs/heads | while read -r b; do
    [ "$b" = "$base" ] && continue
    git worktree list --porcelain | grep -x "branch refs/heads/$b" >/dev/null && continue
    printf '  브랜치만 %s  %s\n' "$b" "$(branch_status "$b")"
  done
  # origin의 준비됨 레인(모든 기계·기준). 있을 때만 보인다. WT_NO_READY=1이면 읽지 않는다(세션 시작 훅).
  local rd=""
  if [ -z "${WT_NO_READY-}" ] && has_origin && rd=$(r_show '*') && [ -n "$rd" ]; then
    echo "준비됨(origin, 모든 기계 — wt flush·자동 묶음 finish가 함께 머지):"; printf '%s\n' "$rd"
  fi
  [ "${1-}" = --conflicts ] || return 0
  merge_tree_ok || die "--conflicts는 git 2.38 이상이 필요합니다(git merge-tree --write-tree)"
  echo "예상 충돌(같은 기준 레인끼리·기준과 미리 합쳐 봄):"
  local w found=0 out
  while IFS= read -r w; do
    [ "$w" = "$(main_root)" ] && continue
    out=$(show_overlap "$w" conflicts) && continue
    found=1; printf '  [%s]\n%s\n' "$w" "$(printf '%s\n' "$out" | sed 's/^/  /')"
  done < <(git worktree list --porcelain | awk '/^worktree /{w=substr($0,10)} /^branch /{print w}')
  [ $found = 1 ] || echo "  없음"
}

cmd_gc() {
  local apply=0; [ "${1-}" = --apply ] && apply=1
  git rev-parse --git-dir >/dev/null 2>&1 || die "git 저장소가 아닙니다"
  local root; root=$(main_root); cd "$root"
  has_origin && git fetch --quiet --prune origin
  [ $apply = 1 ] && git worktree prune
  local base; base=$(default_branch)
  local n=0
  while IFS=$'\t' read -r w b; do
    [ "$w" = "$root" ] && continue
    # 강제 종료로 남은 train 통합 워크트리(<저장소>.wt/.train-<pid>, detached): 그 pid가 끝났으면 지운다.
    case $w in
      "$(dirname "$root")/$(basename "$root").wt/.train-"*)
        ps -p "${w##*.train-}" >/dev/null 2>&1 && continue   # kill -0은 권한 오류도 실패로 낸다
        n=$((n + 1)); printf '  정리 대상(끝난 train의 통합 워크트리) %s\n' "$w"
        [ $apply = 1 ] && { teardown_worktree "$w"; git worktree remove --force "$w"; }
        continue ;;
    esac
    [ -n "$b" ] || continue
    [ -z "$(git -C "$w" status --porcelain 2>/dev/null)" ] || { printf '  유지(미커밋 변경) %s\n' "$w"; continue; }
    is_base_branch "$b" && { printf '  유지(기준 브랜치) %s  %s\n' "$w" "$b"; continue; }
    case $(owner_state "$w") in other*) printf '  유지(다른 세션 사용 중) %s  %s\n' "$w" "$b"; continue ;; esac
    case $(agent_lock_state "$w") in other*) printf '  유지(다른 세션 에이전트 잠금) %s  %s\n' "$w" "$b"; continue ;; esac
    # 방금 만든 워크트리는 커밋이 없어도 main과 같아 보인다. 다른 세션 것일 수 있으니 하루 동안은 건드리지 않는다.
    # 시작점 자체(status가 index.lock을 만들고 지우며 $gd mtime을 갱신한다)와 index(status가 다시 쓴다)는 사용 흔적이 아니라 뺀다.
    local gd; gd=$(git -C "$w" rev-parse --absolute-git-dir 2>/dev/null)
    if [ -n "$gd" ] && [ -n "$(find "$gd" "$w" -mindepth 1 -maxdepth 1 ! -name index ! -name index.lock -mmin -1440 2>/dev/null | sed -n 1p)" ]; then
      printf '  유지(24시간 내 사용) %s  %s\n' "$w" "$b"; continue
    fi
    content_in_base "$(base_ref "$(lane_base "$b")")" "$b" || { printf '  유지(미반영 커밋) %s  %s\n' "$w" "$b"; continue; }
    n=$((n + 1)); printf '  정리 대상 워크트리 %s  %s\n' "$w" "$b"
    if [ $apply = 1 ]; then teardown_worktree "$w"; git worktree remove --force "$w"; git branch -D "$b" >/dev/null; fi
  done < <(git worktree list --porcelain | awk '/^worktree /{w=substr($0,10)} /^branch /{print w"\t"substr($0,19)} /^detached/{print w"\t"}')
  while read -r b; do
    [ "$b" = "$base" ] && continue
    git worktree list --porcelain | grep -x "branch refs/heads/$b" >/dev/null && continue
    is_base_branch "$b" && { printf '  유지(기준 브랜치) 브랜치 %s\n' "$b"; continue; }
    content_in_base "$(base_ref "$(lane_base "$b")")" "$b" || { printf '  유지(미반영 커밋) 브랜치 %s\n' "$b"; continue; }
    n=$((n + 1)); printf '  정리 대상 브랜치 %s\n' "$b"
    [ $apply = 1 ] && git branch -D "$b" >/dev/null
  done < <(git for-each-ref --format='%(refname:short)' refs/heads)
  # 마지막 워크트리를 지우면 <저장소>.wt/ 빈 폴더만 남는다(비어 있을 때만 지워짐)
  [ $apply = 1 ] && { rmdir "$(dirname "$root")/$(basename "$root").wt" 2>/dev/null || true; }
  if [ $apply = 1 ]; then say "${n}개 정리함"; else say "${n}개 정리 가능. 실행: wt gc --apply"; fi
}

case ${1-} in
  start) shift; cmd_start "$@" ;;
  finish) shift; cmd_finish "$@" ;;
  train) shift; cmd_train "$@" ;;
  list|ls) shift; cmd_list "$@" ;;
  gc) shift; cmd_gc "$@" ;;
  overlap) shift; cmd_overlap "$@" ;;
  # 인자가 없거나 --force면 워크트리 맡기, 이름이 있으면 기계 간 선점.
  claim) shift; if [ $# = 0 ] || [ "$1" = --force ]; then cmd_claim "$@"; else cmd_claim_ref "$@"; fi ;;
  unclaim) shift; cmd_unclaim "$@" ;;
  claims) shift; cmd_claims "$@" ;;
  queue) shift; cmd_queue "$@" ;;
  verify) shift; cmd_verify "$@" ;;
  ready) shift; cmd_ready "$@" ;;
  flush) shift; cmd_flush "$@" ;;
  *) awk 'NR>1 && /^set -e/{exit} NR>1{sub(/^# ?/,""); print}' "$0"; exit 1 ;;
esac
